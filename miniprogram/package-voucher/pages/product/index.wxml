<app-navbar title="团购详情" back />

<view class="page product-page page-enter">
  <view wx:if="{{loading}}" class="module-state roamly-panel"><t-loading size="42rpx" /> 正在加载团购商品</view>
  <app-empty wx:elif="{{error || !product}}" description="{{error || '团购商品不存在或已下架'}}" action-text="重新加载" bind:action="retry" />
  <block wx:else>
    <view class="hero">
      <app-image src="{{product.cover}}" custom-class="hero__image" mode="aspectFill" />
      <view class="hero__badge">{{product.productTypeLabel}}</view>
    </view>
    <view class="intro roamly-panel">
      <view class="price-line">
        <view class="price"><text>¥</text>{{product.payAmountText}}</view>
        <view wx:if="{{product.originalAmountText}}" class="origin">门市价 ¥{{product.originalAmountText}}</view>
        <view wx:if="{{product.savingText}}" class="saving">{{product.savingText}}</view>
      </view>
      <view class="benefit">{{product.benefitText}}</view>
      <view class="product-title">{{product.title}}</view>
      <view class="product-subtitle">{{product.subtitle}}</view>
      <view class="intro__meta"><text>已售 {{product.soldCount}}</text><text>每人限购 {{product.perUserLimit || '不限'}}</text></view>
      <view class="summary-row"><text>有效期</text><text>{{product.validityText}}</text><t-icon name="chevron-right" size="30rpx" /></view>
      <view class="summary-row"><text>使用规则</text><text>{{product.reservationRequired ? '需预约' : '免预约'}} · {{product.stackable ? '可叠加' : '不可叠加'}}</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>
    <view wx:if="{{product.packageItems.length}}" class="detail-section roamly-panel">
      <view class="section-heading">套餐明细</view>
      <view wx:for="{{product.packageItems}}" wx:key="id" class="package-row"><text>{{item.name}}</text><text>{{item.quantity}} {{item.unit}}</text></view>
    </view>
    <view class="detail-section roamly-panel">
      <view class="section-heading">购买须知</view>
      <view class="rule-group">
        <view class="rule-label">有效期</view>
        <view class="rule-value">{{product.validityText}}</view>
        <view wx:if="{{product.validBeginTime || product.validEndTime}}" class="rule-note">{{product.validBeginTime || '即刻'}} 至 {{product.validEndTime || '长期'}}</view>
      </view>
      <view class="rule-group">
        <view class="rule-label">可用时间</view>
        <view wx:if="{{product.usageRuleRows.length}}" class="time-list">
          <view wx:for="{{product.usageRuleRows}}" wx:key="dayOfWeek" class="time-row"><text>{{item.dayOfWeek}}</text><text>{{item.closed ? '不可用' : (item.periods[0].open + ' - ' + item.periods[0].close)}}</text></view>
        </view>
        <view wx:else class="rule-value">{{product.usageRules}}</view>
      </view>
      <view class="rule-group">
        <view class="rule-label">使用规则</view>
        <view class="rule-bullets">
          <text>• {{product.reservationRequired ? (product.reservationNotice || '使用前请联系门店预约') : '无需预约，到店出示券码即可'}}</text>
          <text>• {{product.stackable ? '可与门店其他优惠叠加' : '不可与门店其他优惠叠加'}}</text>
          <text>• {{product.refundAnytime ? '未使用可随时退款' : '退款规则以订单说明为准'}}{{product.refundExpired ? '，过期可退' : ''}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{shop}}" class="detail-section roamly-panel shop-card" bind:tap="openShop">
      <view class="section-heading">适用门店</view>
      <view class="shop-card__content">
        <app-image src="{{shop.cover}}" custom-class="shop-card__image" />
        <view class="shop-card__copy"><view>{{shop.name}}</view><text class="shop-card__address">{{shop.address || '查看门店详情'}}</text></view>
        <t-icon name="chevron-right" size="34rpx" />
      </view>
    </view>
    <view wx:if="{{related.length}}" class="related-section">
      <view class="section-heading">本店其他团购</view>
      <view class="related-list">
        <voucher-product-card wx:for="{{related}}" wx:key="product.id" item="{{item}}" compact-shop="{{true}}" bind:select="openRelated" />
      </view>
    </view>
  </block>
</view>

<view wx:if="{{product}}" class="purchase-bar">
  <view class="store-action pressable" bind:tap="openShop"><t-icon name="shop" size="38rpx" /><text>门店</text></view>
  <view class="buy-action pressable {{product.status !== 'ON_SALE' ? 'buy-action--disabled' : ''}}" aria-disabled="{{product.status !== 'ON_SALE'}}" bind:tap="openConfirm">{{product.status === 'ON_SALE' ? (navigating ? '正在前往…' : '去确认订单') : product.saleStatusLabel}}</view>
</view>
