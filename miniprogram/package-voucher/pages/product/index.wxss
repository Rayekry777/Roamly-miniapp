.product-page { padding: 0 0 calc(170rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; height: 560rpx; overflow: hidden; background: #ececf3; }
.hero__image { width: 100%; height: 100%; }
.hero__badge { position: absolute; right: 26rpx; bottom: 24rpx; padding: 9rpx 17rpx; border-radius: 999rpx; background: rgba(36, 35, 49, .78); color: #fff; font-size: 20rpx; }
.intro, .detail-section { margin: 20rpx 24rpx 0; padding: 28rpx; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(45, 42, 80, .06); }
.price-line { display: flex; align-items: baseline; gap: 13rpx; }
.price { color: var(--roamly-primary); font-size: 54rpx; font-weight: 820; }
.price text { font-size: 25rpx; }
.origin { color: #a19faa; font-size: 21rpx; text-decoration: line-through; }
.saving, .benefit { padding: 5rpx 10rpx; border-radius: 7rpx; background: rgba(255, 95, 87, .1); color: #d64d46; font-size: 19rpx; }
.benefit { display: inline-flex; margin-top: 8rpx; }
.product-title { margin-top: 20rpx; font-size: 35rpx; font-weight: 780; line-height: 1.35; }
.product-subtitle { margin-top: 8rpx; color: var(--roamly-muted); font-size: 23rpx; line-height: 1.5; }
.intro__meta { display: flex; justify-content: space-between; margin: 18rpx 0 8rpx; color: var(--roamly-muted); font-size: 21rpx; }
.summary-row { display: grid; grid-template-columns: 108rpx 1fr 30rpx; align-items: center; gap: 10rpx; padding: 20rpx 0; border-top: 1rpx solid var(--roamly-border); font-size: 23rpx; }
.summary-row text:nth-child(2) { overflow: hidden; color: var(--roamly-muted); text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.section-heading { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 760; }
.package-row, .time-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 0; border-top: 1rpx solid var(--roamly-border); color: #5d5b68; font-size: 23rpx; }
.rule-group { padding: 20rpx 0; border-top: 1rpx solid var(--roamly-border); }
.rule-label { margin-bottom: 11rpx; color: var(--roamly-text); font-size: 25rpx; font-weight: 700; }
.rule-value, .rule-note, .rule-bullets { color: #686672; font-size: 23rpx; line-height: 1.65; }
.rule-note { margin-top: 5rpx; color: var(--roamly-muted); }
.rule-bullets { display: flex; flex-direction: column; gap: 7rpx; }
.time-row { padding: 10rpx 0; border: 0; }
.shop-card__content { display: flex; align-items: center; gap: 18rpx; }
.shop-card__image { width: 112rpx !important; height: 90rpx !important; flex: none; overflow: hidden; border-radius: 14rpx; }
.shop-card__copy { min-width: 0; flex: 1; font-size: 26rpx; font-weight: 700; }
.shop-card__address { display: block; overflow: hidden; margin-top: 8rpx; color: var(--roamly-muted); font-size: 21rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.related-section { margin: 32rpx 24rpx 0; }
.related-list { display: flex; flex-direction: column; gap: 16rpx; }
.purchase-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--roamly-border); background: rgba(255, 255, 255, .97); box-shadow: 0 -8rpx 28rpx rgba(36, 35, 49, .08); }
.store-action { display: flex; width: 82rpx; flex: none; flex-direction: column; align-items: center; gap: 3rpx; color: #5f5d68; font-size: 19rpx; }
.buy-action { display: flex; min-height: 82rpx; flex: 1; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--roamly-primary); color: #fff; font-size: 28rpx; font-weight: 760; }
.buy-action--disabled { opacity: .48; }
.module-state { display: flex; min-height: 220rpx; align-items: center; justify-content: center; gap: 14rpx; margin: 32rpx; color: var(--roamly-muted); }
