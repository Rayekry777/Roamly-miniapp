.wallet-root { min-height:100vh; background:var(--roamly-bg); }
.wallet-page { min-height:100vh; padding:24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); background:var(--roamly-bg); }
.filters { display: flex; gap: 28rpx; margin-bottom: 24rpx; overflow-x: auto; white-space: nowrap; }
.filter { color: var(--roamly-muted); font-size: 24rpx; }
.filter--active { color: var(--roamly-primary); font-weight: 700; }
.voucher-card { display:flex; min-height:500rpx; flex-direction:column; padding:26rpx; box-sizing:border-box; }
.voucher-card--USED, .voucher-card--EXPIRED, .voucher-card--REFUNDED { opacity:.72; }
.voucher-card__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.voucher-card__title { display:flex; min-width:0; align-items:center; gap:12rpx; font-size: 30rpx; font-weight: 700; }.voucher-brand { display:flex; width:44rpx; height:44rpx; align-items:center; justify-content:center; border-radius:50%; background:var(--roamly-primary); color:#fff; font-size:22rpx; }
.voucher-card__body { display:flex; gap:20rpx; margin-top:22rpx; }.voucher-thumb { width:150rpx !important; height:150rpx !important; flex:none; border-radius:14rpx; }.voucher-card__copy { min-width:0; flex:1; }.voucher-actions { display:flex; min-height:82rpx; align-items:flex-end; justify-content:flex-end; gap:16rpx; margin-top:auto; padding-top:18rpx; box-sizing:border-box; border-top:1rpx solid var(--roamly-border); }.voucher-actions t-button { width:154rpx; flex:none; }
.status { color: var(--roamly-primary); font-size: 22rpx; }
.shop, .meta, .rules { margin-top: 12rpx; color: var(--roamly-muted); font-size: 23rpx; }
.code { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; margin-top:18rpx; padding:18rpx; border-radius:14rpx; background:var(--roamly-primary-pale); color:var(--roamly-primary); font-size:28rpx; letter-spacing:2rpx; }.code text:first-child { letter-spacing:0; font-size:22rpx; }.code text:last-child { font-weight:800; }
.code--frozen { background: #f5f5f8; color: var(--roamly-muted); letter-spacing: 0; }.code--frozen text:last-child { font-size: 22rpx; font-weight: 500; }
.module-state { display: flex; min-height: 240rpx; align-items: center; justify-content: center; gap: 14rpx; color: var(--roamly-muted); }
.qr-mask { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100vw; height: 100vh; padding: 40rpx; box-sizing: border-box; overflow: hidden; background: rgb(36 35 49 / 52%); }
.qr-dialog { width: min(620rpx, 100%); padding: 32rpx; border-radius: 20rpx; background: #fff; box-sizing: border-box; text-align: center; overflow: hidden; }
.qr-dialog__head { display: flex; align-items: center; justify-content: flex-start; font-size: 36rpx; font-weight: 700; }
.qr-close { color: var(--roamly-muted); font-size: 24rpx; font-weight: 400; }
.voucher-barcode { width: 66%; height: 48rpx; margin: 26rpx auto 16rpx; background: repeating-linear-gradient(90deg, #17171c 0 3rpx, transparent 3rpx 7rpx, #17171c 7rpx 10rpx, transparent 10rpx 15rpx); }
.qr-code-frame { display:flex; width:404rpx; height:404rpx; max-width:100%; align-items:center; justify-content:center; margin:0 auto 18rpx; border:1rpx solid #e7e7eb; border-radius:8rpx; box-sizing:border-box; background:#fff; }
.qr-grid { display:flex; width:380rpx; height:380rpx; flex-direction:column; padding:24rpx; box-sizing:border-box; background:#fff; }
.qr-row { display:flex; min-height:0; flex:1; }
.qr-cell { min-width:0; flex:1; background:#fff; }
.qr-cell--dark { background:#000; }
.qr-voucher-code { margin-top: 2rpx; color: var(--roamly-text); font-size: 32rpx; font-weight: 800; letter-spacing: 5rpx; }
.qr-loading { display: flex; min-height: 320rpx; align-items: center; justify-content: center; gap: 16rpx; color: var(--roamly-muted); }
.qr-error { display:flex; min-height:320rpx; flex-direction:column; align-items:center; justify-content:center; gap:20rpx; color:var(--roamly-muted); font-size:24rpx; }
.qr-tip { margin-top: 22rpx; color: var(--roamly-muted); font-size: 23rpx; }
.qr-dialog__close { display:flex; width:64rpx; height:64rpx; align-items:center; justify-content:center; margin:20rpx auto env(safe-area-inset-bottom); border:3rpx solid #fff; border-radius:50%; background:rgba(36,35,49,.35); color:#fff; font-size:42rpx; line-height:1; box-sizing:border-box; }
