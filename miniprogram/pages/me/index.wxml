<app-navbar title="" back="{{false}}" />

<view class="me-page page-enter">
  <view wx:if="{{!loggedIn}}" class="login-state roamly-panel">
    <app-empty
      description="登录后查看个人资料、订单、券包和动态"
      action-text="去登录"
      bind:action="login"
    />
  </view>
  <block wx:else>
    <view class="profile">
      <view class="profile__main">
        <view class="profile__avatar">
          <app-image src="{{user.icon}}" kind="avatar" />
        </view>
        <view class="profile__copy"><view class="profile__name">{{user.nickName || "Roamly 用户"}}</view><view class="muted">ID {{user.id || "--"}}</view><view class="profile__stats-inline">个人资料与动态</view></view>
      </view>
      <view class="profile__link pressable" bind:tap="openProfile">个人信息 ›</view>
    </view>

    <view class="quick-grid roamly-panel">
      <view class="quick-item pressable" bind:tap="openOrders"><view class="quick-icon"><t-icon name="file" size="42rpx" /></view><text>我的订单</text></view>
      <view class="quick-item pressable" bind:tap="openWallet"><view class="quick-icon"><t-icon name="coupon" size="42rpx" /></view><text>我的券包</text></view>
      <view class="quick-item pressable" bind:tap="publish"><view class="quick-icon"><t-icon name="edit-2" size="42rpx" /></view><text>发布动态</text></view>
      <view class="quick-item pressable" bind:tap="myPosts"><view class="quick-icon"><t-icon name="chat" size="42rpx" /></view><text>我的动态</text></view>
    </view>

  </block>
</view>
