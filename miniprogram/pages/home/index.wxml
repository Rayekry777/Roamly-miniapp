<app-navbar title="Roamly" back="{{false}}" />

<view class="home-page page-enter">
  <view class="home-location">
    <t-icon name="location" size="30rpx" />
    <text wx:if="{{locationLabel}}">{{locationLabel}} · {{locationSource}}</text>
    <text wx:elif="{{locationStatus === 'LOCATING'}}" class="home-location__muted">正在定位…</text>
    <text wx:else class="home-location__muted">定位失败，点击重试</text>
    <text class="home-location__refresh" bind:tap="restoreLocation">{{locationStatus === 'LOCATING' ? '定位中' : '恢复定位'}}</text>
    <text class="home-location__refresh" bind:tap="openCityPicker">切换城市</text>
  </view>
  <!-- 错误状态只保留一个：内容请求失败时优先展示网络错误，避免与定位错误重复占位。 -->
  <view wx:if="{{!feedError && (locationStatus === 'FAILED' || locationStatus === 'DENIED')}}" class="home-location-error">
    <t-icon name="location" size="56rpx" />
    <text>{{locationStatus === 'DENIED' ? '未获得定位权限，当前按城市浏览' : '定位不可用，当前按城市浏览'}}</text>
    <view class="home-location-error__action" bind:tap="restoreLocation">重新定位</view>
  </view>

  <block wx:if="{{cityReady}}">
  <view class="home-tabs" aria-role="tablist">
    <view
      class="home-tab {{mode === 'RECOMMENDED' ? 'home-tab--active' : ''}}"
      data-mode="RECOMMENDED"
      bind:tap="switchMode"
      aria-role="tab"
      aria-selected="{{mode === 'RECOMMENDED'}}"
    >
      推荐
    </view>
    <view
      class="home-tab {{mode === 'FOLLOWING' ? 'home-tab--active' : ''}}"
      data-mode="FOLLOWING"
      bind:tap="switchMode"
      aria-role="tab"
      aria-selected="{{mode === 'FOLLOWING'}}"
    >
      关注
    </view>
  </view>

  <view class="home-sections">
    <view class="home-sections__heading">
      <text>漫游分区</text>
      <text class="home-sections__hint">找到同频的人</text>
    </view>
    <view wx:if="{{sectionLoading}}" class="home-sections__loading">
      <t-skeleton theme="avatar" row-col="{{[1]}}" loading />
    </view>
    <section-scroll
      wx:elif="{{sections.length}}"
      sections="{{sections}}"
      bind:select="openSection"
    />
    <view wx:else class="home-sections__error" bind:tap="retrySections">
      {{sectionError || "暂无可用分区"}} · 点击重试
    </view>
  </view>

  <view class="feed-list">
    <view wx:if="{{feedLoading && !feedItems.length}}" class="feed-skeleton">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="feed-skeleton__card">
        <t-skeleton theme="avatar" row-col="{{[1, 1, 1, 1]}}" loading />
      </view>
    </view>

    <app-empty
      wx:elif="{{mode === 'FOLLOWING' && !loggedIn}}"
      description="登录后查看你关注的动态"
      action-text="去登录"
      bind:action="loginForFollowing"
    />

    <app-empty
      wx:elif="{{feedError && !feedItems.length}}"
      description="{{feedError}}"
      action-text="重新加载"
      bind:action="retryFeed"
    />

    <app-empty
      wx:elif="{{!feedItems.length}}"
      description="{{mode === 'FOLLOWING' ? '关注的人还没有发布动态' : '这里还没有漫游动态'}}"
    />

    <block wx:else>
      <post-card
        wx:for="{{feedItems}}"
        wx:key="id"
        post="{{item}}"
        current-user-id="{{currentUserId}}"
        liking="{{likingIds[item.id]}}"
        following="{{followingIds[item.author.id]}}"
        bind:openpost="openPost"
        bind:openauthor="openAuthor"
        bind:opensection="openSection"
        bind:like="toggleLike"
        bind:comment="openComment"
        bind:follow="toggleFollow"
        bind:openhighlight="openHighlight"
      />
      <view class="list-footer">
        {{feedLoading ? "正在加载更多" : feedHasMore ? "继续上滑加载" : "已经漫游到底了"}}
      </view>
    </block>
  </view>
  </block>
</view>

<view wx:if="{{cityPickerVisible}}" class="city-picker" catch:tap="closeCityPicker">
  <view class="city-picker__panel" catch:tap="noop">
    <view class="city-picker__header">
      <view>
        <view class="city-picker__title">切换城市</view>
        <view class="city-picker__hint">切换后按所选城市浏览，不代表当前真实位置</view>
      </view>
      <view class="city-picker__close pressable" bind:tap="closeCityPicker">
        <t-icon name="close" size="36rpx" />
      </view>
    </view>
    <scroll-view class="city-picker__list" scroll-y>
      <view wx:for="{{cities}}" wx:key="code" class="city-picker__item {{item.isCurrentLocation ? 'city-picker__item--disabled' : ''}}" data-code="{{item.code}}" bind:tap="selectCity">
        <text>{{item.name}}</text>
        <view wx:if="{{item.isCurrentLocation}}" class="city-picker__current"><t-icon name="location" size="24rpx" />当前定位</view>
      </view>
    </scroll-view>
  </view>
</view>
