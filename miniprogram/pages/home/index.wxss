.home-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.home-tabs {
  display: flex;
  justify-content: center;
  gap: 54rpx;
  padding: 18rpx 32rpx 12rpx;
}

.home-tab {
  position: relative;
  padding: 12rpx 8rpx 18rpx;
  color: var(--roamly-muted);
  font-size: 30rpx;
  font-weight: 650;
}

.home-tab--active {
  color: var(--roamly-text);
}

.home-tab--active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 34rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--roamly-primary);
  content: "";
  transform: translateX(-50%);
}

.home-sections {
  padding-top: 20rpx;
}

.home-sections__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 32rpx 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.home-sections__hint,
.home-sections__error {
  color: var(--roamly-muted);
  font-size: 21rpx;
  font-weight: 400;
}

.home-sections__loading {
  padding: 12rpx 32rpx 24rpx;
}

.home-sections__error {
  padding: 20rpx 32rpx 30rpx;
  text-align: center;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 8rpx 24rpx 0;
}

.feed-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-skeleton__card {
  min-height: 280rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: #fff;
}
