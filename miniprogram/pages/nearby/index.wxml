<app-navbar title="附近" back="{{false}}" />
<view class="services-page">
  <view class="services-heading">发现身边好店</view>
  <view class="services-caption">吃点好的，找点好玩的</view>
  <view wx:if="{{loading}}" class="services-loading">正在加载…</view>
  <app-empty wx:elif="{{error}}" description="{{error}}" action-text="重试" bind:action="load" />
  <view wx:else class="services-grid">
    <view wx:for="{{categories}}" wx:key="id" class="service-entry" data-id="{{item.id}}" bind:tap="openCategory" aria-role="button" aria-label="进入{{item.name}}">
      <view class="service-icon {{item.id === '1' ? 'service-icon--food' : 'service-icon--play'}}"><app-image src="{{item.icon}}" kind="category" mode="aspectFit" custom-class="service-image" /></view>
      <view class="service-name">{{item.name}}</view>
      <view class="service-hint">{{item.id === '1' ? '餐厅 · 小吃 · 咖啡' : '放松 · 聚会 · 玩乐'}}</view>
    </view>
  </view>
</view>
