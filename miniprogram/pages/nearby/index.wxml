<app-navbar title="附近" back="{{false}}" />

<view class="page page-enter">
  <view class="nearby-hero roamly-panel">
    <view>
      <view class="eyebrow">NEARBY ROAM</view>
      <view class="nearby-hero__title">{{cityName || "当前城市"}}好去处</view>
      <view class="nearby-hero__hint">{{locationHint}}</view>
    </view>
    <view
      class="nearby-hero__location pressable"
      bind:tap="retryLocation"
      aria-role="button"
      aria-label="重新获取当前位置"
    >
      <t-icon name="location" size="38rpx" />
    </view>
  </view>

  <view class="nearby-search roamly-panel">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索当前城市的商户"
      bind:change="onKeyword"
      bind:submit="search"
    />
  </view>

  <scroll-view class="type-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        class="chip {{!typeId ? 'chip--active' : ''}}"
        data-id=""
        bind:tap="selectType"
      >
        全部
      </view>
      <view
        wx:for="{{types}}"
        wx:key="id"
        class="chip {{item.id === typeId ? 'chip--active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="selectType"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="nearby-filter-row">
    <view
      class="nearby-sort {{sort === 'POPULAR' ? 'nearby-sort--active' : ''}}"
      data-sort="POPULAR"
      bind:tap="selectSort"
    >
      热门
    </view>
    <view
      class="nearby-sort {{sort === 'DISTANCE' ? 'nearby-sort--active' : ''}}"
      data-sort="DISTANCE"
      bind:tap="selectSort"
    >
      距离
    </view>
    <view
      class="nearby-sort {{sort === 'SCORE' ? 'nearby-sort--active' : ''}}"
      data-sort="SCORE"
      bind:tap="selectSort"
    >
      评分
    </view>
    <view class="nearby-more pressable" bind:tap="openShopList">更多筛选</view>
  </view>

  <view wx:if="{{loading && !shops.length}}" class="shop-skeletons">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="shop-skeleton roamly-panel">
      <t-skeleton theme="avatar" row-col="{{[1, 1, 1]}}" loading />
    </view>
  </view>

  <app-empty
    wx:elif="{{error && !shops.length}}"
    description="{{error}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <app-empty
    wx:elif="{{!shops.length}}"
    description="当前筛选下没有找到商户"
  />

  <view wx:else class="shop-list">
    <shop-card
      wx:for="{{shops}}"
      wx:key="id"
      shop="{{item}}"
      bind:select="openShop"
    />
    <view wx:if="{{loading}}" class="list-footer">
      <t-loading size="38rpx" />
      正在加载更多
    </view>
    <view wx:elif="{{error}}" class="list-footer list-footer--error" bind:tap="retry">
      {{error}}，点击重试
    </view>
    <view wx:elif="{{!hasMore}}" class="list-footer">已经逛到底了</view>
  </view>
</view>
