<app-navbar title="附近" back="{{false}}" />

<view class="page page-enter">
  <view class="nearby-hero roamly-panel">
    <view>
      <view class="nearby-hero__title">{{cityName || "当前城市"}}附近团购</view>
      <view class="nearby-hero__subtitle">发现现在就值得去的好店好价</view>
    </view>
    <view
      class="nearby-hero__location pressable"
      bind:tap="retryLocation"
      aria-role="button"
      aria-label="重新获取当前位置"
    >
      <t-icon name="location" size="38rpx" />
    </view>
  </view>

  <view class="nearby-search roamly-panel">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索商品或商户"
      bind:change="onKeyword"
      bind:submit="search"
    />
  </view>

  <scroll-view class="type-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        class="chip {{!typeId ? 'chip--active' : ''}}"
        data-id=""
        bind:tap="selectType"
      >
        全部
      </view>
      <view
        wx:for="{{types}}"
        wx:key="id"
        class="chip {{item.id === typeId ? 'chip--active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="selectType"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="nearby-filter-row">
    <view
      class="nearby-sort {{sort === 'RECOMMENDED' ? 'nearby-sort--active' : ''}}"
      data-sort="RECOMMENDED"
      bind:tap="selectSort"
    >
      综合
    </view>
    <view
      class="nearby-sort {{sort === 'SALES' ? 'nearby-sort--active' : ''}}"
      data-sort="SALES"
      bind:tap="selectSort"
    >
      销量
    </view>
    <view
      class="nearby-sort {{sort === 'DISTANCE' ? 'nearby-sort--active' : ''}}"
      data-sort="DISTANCE"
      bind:tap="selectSort"
    >
      距离
    </view>
    <view
      class="nearby-sort {{sort === 'PRICE_ASC' ? 'nearby-sort--active' : ''}}"
      data-sort="PRICE_ASC"
      bind:tap="selectSort"
    >
      价格最低
    </view>
  </view>

  <view wx:if="{{loading && !products.length}}" class="product-skeletons">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="shop-skeleton roamly-panel">
      <t-skeleton theme="avatar" row-col="{{[1, 1, 1]}}" loading />
    </view>
  </view>

  <app-empty
    wx:elif="{{error && !products.length}}"
    description="{{error}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <app-empty
    wx:elif="{{!products.length}}"
    description="当前筛选下没有找到可购买的团购"
  />

  <view wx:else class="product-list">
    <voucher-product-card
      wx:for="{{products}}"
      wx:key="product.id"
      item="{{item}}"
      bind:select="openProduct"
    />
    <view wx:if="{{loading}}" class="list-footer">
      <t-loading size="38rpx" />
      正在加载更多
    </view>
    <view wx:elif="{{error}}" class="list-footer list-footer--error" bind:tap="retry">
      {{error}}，点击重试
    </view>
    <view wx:elif="{{!hasMore}}" class="list-footer">已经逛到底了</view>
  </view>
</view>
