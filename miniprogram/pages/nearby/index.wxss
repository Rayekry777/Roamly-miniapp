.services-page { min-height: 75vh; padding: 48rpx 36rpx; background: #fff; }
.services-heading { font-size: 40rpx; font-weight: 700; color: #25232b; }
.services-caption { margin-top: 16rpx; color: #8a8790; font-size: 26rpx; }
.services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx; margin-top: 56rpx; }
.service-entry { padding: 38rpx 12rpx; text-align: center; border-radius: 30rpx; background: #faf9f7; }
.service-icon { width: 132rpx; height: 132rpx; margin: 0 auto 24rpx; border-radius: 40rpx; }
.service-icon--food { background: #fff0df; }
.service-icon--play { background: #f0edff; }
.service-image { width: 132rpx; height: 132rpx; }
.service-name { font-size: 32rpx; font-weight: 600; }
.service-hint { margin-top: 16rpx; font-size: 22rpx; color: #89858c; }
.services-loading { padding: 60rpx; text-align: center; color: #89858c; }
