<app-navbar title="分区" back="{{false}}" />

<view class="page page-enter">
  <view class="sections-hero roamly-panel">
    <view class="sections-hero__icon">
      <t-icon name="app" size="52rpx" />
    </view>
    <view class="sections-hero__content">
      <view class="sections-hero__title">找到你的漫游分区</view>
      <view class="sections-hero__description">关注感兴趣的分区，优先发现同频内容。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>全部分区</text>
      <text wx:if="{{loggedIn}}" class="section-link">已关注优先</text>
    </view>

    <view wx:if="{{loading && !sections.length}}" class="sections-skeleton">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="section-card roamly-panel">
        <t-skeleton theme="avatar" row-col="{{[1, 1]}}" loading />
      </view>
    </view>

    <app-empty
      wx:elif="{{error && !sections.length}}"
      description="{{error}}"
      action-text="重新加载"
      bind:action="retrySections"
    />

    <app-empty wx:elif="{{!sections.length}}" description="暂无可用分区" />

    <view wx:else class="sections-list">
      <view
        wx:for="{{sections}}"
        wx:key="id"
        class="section-card roamly-panel pressable"
        data-id="{{item.id}}"
        bind:tap="openSection"
        aria-role="button"
        aria-label="进入{{item.name}}分区"
      >
        <view class="section-card__icon">
          <app-image src="{{item.icon}}" kind="category" />
        </view>
        <view class="section-card__body">
          <view class="section-card__heading">
            <text class="section-card__name">{{item.name}}</text>
            <text wx:if="{{item.code === 'ROAM_DAILY'}}" class="section-card__badge">默认</text>
            <text wx:elif="{{item.allowShopVisit}}" class="section-card__badge section-card__badge--shop">探店</text>
          </view>
          <view class="section-card__description">
            {{item.description || "进入分区查看最新动态"}}
          </view>
        </view>
        <view
          class="section-card__follow {{item.followedByMe ? 'section-card__follow--active' : ''}}"
          data-id="{{item.id}}"
          data-followed="{{item.followedByMe}}"
          catch:tap="toggleFollow"
          aria-role="button"
          aria-disabled="{{followingIds[item.id]}}"
          aria-label="{{item.followedByMe ? '取消关注' : '关注'}}{{item.name}}"
        >
          {{followingIds[item.id] ? "处理中" : item.followedByMe ? "已关注" : "+ 关注"}}
        </view>
      </view>
    </view>
  </view>
</view>
