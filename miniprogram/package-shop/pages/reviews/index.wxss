.reviews-heading { display: flex; align-items: center; justify-content: space-between; }
.reviews-heading__title { margin-top: 8rpx; font-size: 36rpx; font-weight: 750; }
.sort-row { display: flex; gap: 34rpx; margin: 30rpx 0 24rpx; }
.sort-item { color: var(--roamly-muted); font-size: 24rpx; }
.sort-item--active { color: var(--roamly-text); font-weight: 700; }
.reviews-list, .reviews-skeletons { display: flex; flex-direction: column; gap: 20rpx; }
.review-skeleton { min-height: 240rpx; padding: 24rpx; }
.review-card { padding: 28rpx; }
.review-card__head { display: flex; align-items: center; gap: 16rpx; }
.review-card__avatar { width: 72rpx; height: 72rpx; overflow: hidden; border-radius: 50%; }
.review-card__identity { min-width: 0; flex: 1; }
.review-card__name { font-size: 28rpx; font-weight: 700; }
.review-card__meta { margin-top: 6rpx; color: var(--roamly-muted); font-size: 20rpx; }
.review-card__score { color: var(--roamly-primary); font-size: 34rpx; font-weight: 800; }
.review-card__badges { display: flex; align-items: center; gap: 10rpx; min-height: 48rpx; margin-top: 14rpx; }
.review-card__content { margin-top: 14rpx; color: var(--roamly-text); font-size: 27rpx; line-height: 1.65; white-space: pre-wrap; }
.review-media-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 18rpx; }
.review-media-image { width: 100%; height: 180rpx; overflow: hidden; border-radius: 18rpx; }
.review-editor-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(24, 22, 39, 0.42); }
.review-editor { width: 100%; max-height: 88vh; padding: 28rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); overflow-y: auto; box-sizing: border-box; border-radius: 38rpx 38rpx 0 0; background: var(--roamly-bg); }
.review-editor__head, .review-editor__actions, .score-picker { display: flex; align-items: center; justify-content: space-between; }
.review-editor__head { font-size: 34rpx; font-weight: 750; }
.score-picker { justify-content: flex-start; gap: 18rpx; margin: 24rpx 0; color: var(--roamly-muted); font-size: 24rpx; }
.score-picker__stars { display: flex; gap: 10rpx; }
.score-star { color: #d3d1da; font-size: 44rpx; }
.score-star--active { color: #ff9a43; }
.form-error { margin-top: 14rpx; color: var(--roamly-primary); font-size: 23rpx; }
.review-editor__actions { justify-content: flex-end; gap: 20rpx; margin-top: 22rpx; }
