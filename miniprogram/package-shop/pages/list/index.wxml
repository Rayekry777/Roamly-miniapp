<app-navbar title="{{title}}" back />

<view class="page page-enter">
  <view class="shop-list-toolbar">
    <view class="shop-list-search">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索店铺或店内优惠"
      bind:change="onKeyword"
      bind:submit="search"
    />
    </view>
  </view>

  <view wx:if="{{!productId}}" class="category-grid {{categoriesExpanded ? 'category-grid--expanded' : ''}}">
    <view class="category-cell {{!typeId ? 'category-cell--active' : ''}}" data-id="" bind:tap="selectType"><view class="category-all">全</view><text>全部</text></view>
    <view wx:for="{{types}}" wx:key="id" class="category-cell {{typeId === item.id ? 'category-cell--active' : ''}}" data-id="{{item.id}}" bind:tap="selectType">
      <view class="category-icon"><app-image src="{{item.icon}}" kind="category" mode="aspectFit" custom-class="category-image" /></view><text>{{item.name}}</text>
    </view>
  </view>
  <view wx:if="{{!productId}}" class="category-toggle" bind:tap="toggleCategories">{{categoriesExpanded ? '收起分类 ∧' : '全部分类 ∨'}}</view>

  <view wx:if="{{!productId}}" class="sort-row">
    <view
      wx:for="{{sortOptions}}"
      wx:key="value"
      class="sort-item {{sort === item.value ? 'sort-item--active' : ''}}"
      data-sort="{{item.value}}"
      bind:tap="selectSort"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading && !shops.length}}" class="shop-list">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="shop-skeleton roamly-panel">
      <t-skeleton theme="avatar" row-col="{{[1, 1, 1]}}" loading />
    </view>
  </view>

  <app-empty
    wx:elif="{{error && !shops.length}}"
    description="{{error}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <app-empty wx:elif="{{!shops.length}}" description="没有找到相关商户" />

  <view wx:else class="shop-list">
    <view wx:if="{{productId}}" class="filtered-hint">适用门店 · 仅展示真实关联门店</view>
    <shop-card
      wx:for="{{shops}}"
      wx:key="id"
      shop="{{item}}"
      compact="{{false}}"
      bind:voucher="openVoucher"
      bind:select="openShop"
      bind:navigate="navigateShop"
    />
    <view wx:if="{{loading}}" class="list-footer">
      <t-loading size="38rpx" />
      加载中
    </view>
    <view wx:elif="{{error}}" class="list-footer list-footer--error" bind:tap="retry">
      {{error}}，点击重试
    </view>
    <view wx:elif="{{!hasMore}}" class="list-footer">没有更多商户了</view>
  </view>
</view>
