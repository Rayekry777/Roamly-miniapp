<app-navbar title="商户列表" back />

<view class="page page-enter">
  <view class="shop-list-toolbar">
    <view class="shop-list-city" bind:tap="openCityPicker">
      <t-icon name="location" size="28rpx" />
      <text>{{selectedCity ? selectedCity.name : '杭州'}} · 切换城市</text>
    </view>
    <view class="shop-list-search">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索门店/区域/地点"
      bind:change="onKeyword"
      bind:submit="search"
    />
    </view>
  </view>

  <scroll-view wx:if="{{!productId}}" class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        class="chip {{!typeId ? 'chip--active' : ''}}"
        data-id=""
        bind:tap="selectType"
      >
        全部
      </view>
      <view
        wx:for="{{types}}"
        wx:key="id"
        class="chip {{item.id === typeId ? 'chip--active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="selectType"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!productId}}" class="sort-row">
    <view
      wx:for="{{sortOptions}}"
      wx:key="value"
      class="sort-item {{sort === item.value ? 'sort-item--active' : ''}}"
      data-sort="{{item.value}}"
      bind:tap="selectSort"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading && !shops.length}}" class="shop-list">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="shop-skeleton roamly-panel">
      <t-skeleton theme="avatar" row-col="{{[1, 1, 1]}}" loading />
    </view>
  </view>

  <app-empty
    wx:elif="{{error && !shops.length}}"
    description="{{error}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <app-empty wx:elif="{{!shops.length}}" description="没有找到相关商户" />

  <view wx:else class="shop-list">
    <view wx:if="{{productId}}" class="filtered-hint">适用门店 · 仅展示真实关联门店</view>
    <shop-card
      wx:for="{{shops}}"
      wx:key="id"
      shop="{{item}}"
      compact="{{true}}"
      bind:select="openShop"
      bind:navigate="navigateShop"
    />
    <view wx:if="{{loading}}" class="list-footer">
      <t-loading size="38rpx" />
      加载中
    </view>
    <view wx:elif="{{error}}" class="list-footer list-footer--error" bind:tap="retry">
      {{error}}，点击重试
    </view>
    <view wx:elif="{{!hasMore}}" class="list-footer">没有更多商户了</view>
  </view>
</view>

<view wx:if="{{cityPickerVisible}}" class="city-picker" catch:tap="closeCityPicker">
  <view class="city-picker__panel" catch:tap="noop">
    <view class="city-picker__header">
      <view>
        <view class="city-picker__title">切换城市</view>
        <view class="city-picker__hint">按所选城市浏览，不代表当前真实位置</view>
      </view>
      <view class="city-picker__close pressable" bind:tap="closeCityPicker"><t-icon name="close" size="36rpx" /></view>
    </view>
    <scroll-view class="city-picker__list" scroll-y>
      <view wx:for="{{cities}}" wx:key="code" class="city-picker__item" data-code="{{item.code}}" bind:tap="selectCity"><text>{{item.name}}</text></view>
    </scroll-view>
  </view>
</view>
