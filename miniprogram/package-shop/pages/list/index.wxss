.page { min-height:100vh; padding-left:36rpx; padding-right:36rpx; background:#fff; }
.shop-list-toolbar { display:flex; align-items:center; gap:18rpx; margin-top:18rpx; padding-bottom:12rpx; }
.shop-city { display:flex; flex:none; align-items:center; gap:4rpx; color:var(--roamly-text); font-size:26rpx; }

.shop-list-search {
  overflow: hidden;
  flex:1;
  margin-top: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background:#f4f5f7;
}

.shop-list-search t-search { min-height: 72rpx; }

.chip-scroll {
  width: 100%;
  margin-top: 22rpx;
}

.sort-row {
  display: flex;
  gap: 34rpx;
  margin-bottom: 24rpx;
}

.sort-item {
  color: var(--roamly-muted);
  font-size: 24rpx;
}

.sort-item--active {
  color: var(--roamly-text);
  font-weight: 700;
}

.filtered-hint { padding:18rpx 0 4rpx; color:var(--roamly-muted); font-size:22rpx; }

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.shop-skeleton {
  min-height: 190rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.list-footer--error {
  color: var(--roamly-primary);
}
