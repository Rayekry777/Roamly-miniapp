.search-panel {
  overflow: hidden;
  margin-top: 24rpx;
}

.chip-scroll {
  width: 100%;
  margin-top: 22rpx;
}

.sort-row {
  display: flex;
  gap: 34rpx;
  margin-bottom: 24rpx;
}

.sort-item {
  color: var(--roamly-muted);
  font-size: 24rpx;
}

.sort-item--active {
  color: var(--roamly-text);
  font-weight: 700;
}

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.shop-skeleton {
  min-height: 190rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.list-footer--error {
  color: var(--roamly-primary);
}
