.page { min-height:100vh; padding-left:24rpx; padding-right:24rpx; background:#f6f6f8; }

.shop-list-toolbar { display:flex; align-items:center; gap:18rpx; margin-top:18rpx; padding-bottom:28rpx; }

.shop-list-search {
  overflow: hidden;
  flex:1;
  margin-top: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background:#f4f5f7;
}

.shop-list-search t-search { min-height: 72rpx; }

.sort-item {
  color: var(--roamly-muted);
  font-size: 24rpx;
}

.filtered-hint { padding:18rpx 0 4rpx; color:var(--roamly-muted); font-size:22rpx; }

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.shop-skeleton {
  min-height: 190rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.list-footer--error {
  color: var(--roamly-primary);
}

.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22rpx 8rpx; max-height: 268rpx; overflow: hidden; }
.category-grid--expanded { max-height: none; }
.category-cell { display: flex; flex-direction: column; align-items: center; gap: 10rpx; font-size: 24rpx; color: #55515b; }
.category-cell--active { color: #ff603e; font-weight: 600; }
.category-icon, .category-image { width: 78rpx; height: 78rpx; }
.category-toggle { text-align: center; color: #89858c; padding: 18rpx; font-size: 22rpx; }
.sort-row { display: flex; justify-content: space-between; gap: 12rpx; padding: 22rpx 0; position: sticky; top: 0; z-index: 2; background: #f6f6f8; }
.sort-item--active { color: #ff603e; }
