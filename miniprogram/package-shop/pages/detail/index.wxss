.detail-skeleton {
  min-height: 520rpx;
  padding: 28rpx;
}

.gallery {
  height: 430rpx;
  overflow: hidden;
  border-radius: 44rpx;
  background: #e9e9f0;
}

.detail {
  margin-top: 26rpx;
  padding: 34rpx;
}

.detail__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.detail__identity {
  min-width: 0;
}

.detail__name {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 750;
}

.score {
  flex: none;
  color: var(--roamly-primary);
  font-size: 44rpx;
  font-weight: 800;
}

.score text {
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.address {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 24rpx;
  color: #666472;
  font-size: 25rpx;
}

.address text {
  flex: 1;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 26rpx;
  margin-top: 24rpx;
  color: var(--roamly-muted);
  font-size: 22rpx;
}

.open-hours {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--roamly-border);
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.module-state {
  display: flex;
  min-height: 180rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.voucher {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx;
}

.voucher__price {
  color: var(--roamly-primary);
  font-size: 50rpx;
  font-weight: 800;
}

.voucher__price text {
  font-size: 22rpx;
}

.voucher__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.voucher__copy .strong {
  color: var(--roamly-text);
  font-size: 27rpx;
  font-weight: 700;
}

.voucher__copy text {
  color: var(--roamly-muted);
  font-size: 21rpx;
}
.voucher-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }

.review-summary {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 28rpx;
}

.review-summary__score {
  color: var(--roamly-primary);
  font-size: 54rpx;
  font-weight: 800;
}

.review-summary__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.review-summary__copy text {
  color: var(--roamly-muted);
  font-size: 21rpx;
  font-weight: 400;
}

.related-posts {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.related-post {
  padding: 26rpx;
}

.related-post__author {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.related-post__avatar {
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
  flex: none;
  border-radius: 50%;
}

.related-post__author-copy {
  min-width: 0;
  flex: 1;
}

.related-post__author-name {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-post__time {
  margin-top: 4rpx;
  color: var(--roamly-muted);
  font-size: 19rpx;
}

.related-post__title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.related-post__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
  color: var(--roamly-muted);
  font-size: 21rpx;
}

.related-post__meta text:first-child {
  overflow: hidden;
  color: var(--roamly-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-post__meta text:last-child {
  flex: none;
}

.address-detail {
  padding: 28rpx;
}

.address-detail .section-title {
  margin-bottom: 12rpx;
}

.address-detail__row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 20rpx;
  padding: 18rpx 0;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.address-detail__row text:last-child {
  color: var(--roamly-text);
  text-align: right;
}
