.gallery { height: 430rpx; overflow: hidden; border-radius: 44rpx; background: #e9e9f0; }.detail { margin-top: 26rpx; padding: 34rpx; }.detail__head { display: flex; align-items: flex-start; justify-content: space-between; }.detail__name { margin-top: 12rpx; font-size: 42rpx; font-weight: 750; }.score { color: var(--roamly-primary); font-size: 44rpx; font-weight: 800; }.score text { color: var(--roamly-muted); font-size: 20rpx; }.address { display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx; color: #666472; font-size: 25rpx; }.stats { display: flex; flex-wrap: wrap; gap: 14rpx 26rpx; margin-top: 24rpx; color: var(--roamly-muted); font-size: 22rpx; }.voucher { display: flex; min-height: 150rpx; align-items: center; gap: 22rpx; padding: 24rpx; }.voucher__price { color: var(--roamly-primary); font-size: 50rpx; font-weight: 800; }.voucher__price text { font-size: 22rpx; }.voucher__copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }.voucher__copy .strong { color: var(--roamly-text); font-size: 27rpx; font-weight: 700; }.voucher__copy text { color: var(--roamly-muted); font-size: 21rpx; }
