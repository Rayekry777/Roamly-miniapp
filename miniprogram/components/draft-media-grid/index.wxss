.draft-media {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.draft-media__item,
.draft-media__add {
  position: relative;
  height: 210rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f1f1f5;
}

.draft-media__image {
  width: 100%;
  height: 100%;
}

.draft-media__status {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(27, 26, 34, 0.62);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.draft-media__retry {
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
}

.draft-media__remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(27, 26, 34, 0.68);
  color: #fff;
}

.draft-media__order {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  display: flex;
  justify-content: space-between;
  color: #fff;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.55));
}

.draft-media__order view {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(27, 26, 34, 0.55);
}

.draft-media__add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
  border: 2rpx dashed #d8d7df;
  box-sizing: border-box;
  color: var(--roamly-muted);
  font-size: 21rpx;
}
