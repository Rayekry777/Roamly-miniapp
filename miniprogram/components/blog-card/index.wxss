.blog-card { display: flex; min-height: 230rpx; overflow: hidden; border: 1rpx solid #ececf3; border-radius: 40rpx; background: #fff; box-shadow: 0 14rpx 38rpx rgba(45,42,80,.08); }.cover { width: 235rpx; height: 230rpx; }.content { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: 24rpx; }.title { overflow: hidden; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.summary { display: -webkit-box; overflow: hidden; margin-top: 14rpx; color: #888693; font-size: 23rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; color: #9997a5; font-size: 21rpx; }.author { display: flex; min-width: 0; align-items: center; gap: 10rpx; }.avatar { width: 42rpx; height: 42rpx; overflow: hidden; border-radius: 50%; }.pressable { transition: transform 160ms ease, opacity 160ms ease; }.pressable:active { transform: scale(.98); opacity: .86; }
