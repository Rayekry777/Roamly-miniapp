.comment-item {
  display: flex;
  gap: 18rpx;
}

.comment-item__avatar {
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  flex: none;
  border-radius: 50%;
  background: #ececf3;
}

.comment-item--reply .comment-item__avatar {
  width: 54rpx;
  height: 54rpx;
}

.comment-item__body {
  min-width: 0;
  flex: 1;
}

.comment-item__header,
.comment-item__identity,
.comment-item__actions,
.comment-item__action {
  display: flex;
  align-items: center;
}

.comment-item__header {
  justify-content: space-between;
  gap: 16rpx;
}

.comment-item__identity {
  min-width: 0;
  gap: 10rpx;
}

.comment-item__name {
  max-width: 240rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-item__author-badge {
  flex: none;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: #fff0ee;
  color: var(--roamly-primary);
  font-size: 17rpx;
}

.comment-item__time,
.comment-item__delete {
  flex: none;
  color: var(--roamly-muted);
  font-size: 19rpx;
}

.comment-item__content,
.comment-item__deleted {
  margin-top: 9rpx;
  font-size: 25rpx;
  line-height: 1.58;
  word-break: break-all;
}

.comment-item__deleted {
  color: var(--roamly-muted);
  font-style: italic;
}

.comment-item__reply-to {
  margin-right: 8rpx;
  color: var(--roamly-accent);
}

.comment-item__actions {
  gap: 30rpx;
  margin-top: 12rpx;
}

.comment-item__action {
  gap: 6rpx;
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.comment-item__action--liked {
  color: var(--roamly-primary);
}
