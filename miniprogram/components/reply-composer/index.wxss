.reply-composer {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--roamly-border);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 32rpx rgba(45, 42, 80, 0.08);
}

.reply-composer__target,
.reply-composer__row {
  display: flex;
  align-items: center;
}

.reply-composer__target {
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
  color: var(--roamly-accent);
  font-size: 21rpx;
}

.reply-composer__row {
  gap: 14rpx;
}

.reply-composer__input {
  max-height: 176rpx;
  min-height: 44rpx;
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 28rpx;
  background: #f3f3f7;
  box-sizing: content-box;
  color: var(--roamly-text);
  font-size: 25rpx;
  line-height: 1.5;
}

.reply-composer__submit {
  flex: none;
  padding: 17rpx 22rpx;
  border-radius: 999rpx;
  background: var(--roamly-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.reply-composer__submit[aria-disabled="true"] {
  opacity: 0.55;
}
