.shop-card { padding: 24rpx; border-radius: 26rpx; background: #fff; }
.shop-main { display: flex; gap: 22rpx; }
.shop-cover { width: 142rpx; height: 142rpx; border-radius: 20rpx; flex-shrink: 0; }
.shop-content { flex: 1; min-width: 0; }
.shop-title { font-size: 31rpx; font-weight: 700; color: #29252e; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.shop-rating { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; font-size: 25rpx; color: #ff603e; }
.shop-sales, .shop-meta, .shop-bottom { color: #939099; font-size: 22rpx; }
.shop-meta { margin-top: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.shop-bottom { display: flex; justify-content: space-between; margin-top: 10rpx; }
.shop-navigation { color: #77727d; }
.shop-vouchers { margin-top: 20rpx; padding-top: 12rpx; border-top: 1rpx solid #f4f2f5; }
.voucher-row { display: flex; align-items: center; gap: 10rpx; min-height: 58rpx; }
.voucher-kind { color: #ff603e; background: #fff2ed; font-size: 19rpx; padding: 4rpx 6rpx; border-radius: 6rpx; flex-shrink: 0; }
.voucher-price { color: #ff603e; font-size: 29rpx; font-weight: 700; flex-shrink: 0; }
.voucher-original { color: #aaa6ad; text-decoration: line-through; font-size: 21rpx; flex-shrink: 0; }
.voucher-title { font-size: 24rpx; color: #49434f; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.no-vouchers, .more-vouchers { font-size: 22rpx; color: #96919b; padding: 10rpx 0; }
.more-vouchers { text-align: right; }
.shop-cover-wrap { width: 142rpx; height: 142rpx; flex-shrink: 0; }
