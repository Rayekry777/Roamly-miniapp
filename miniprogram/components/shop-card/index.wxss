.shop-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--roamly-border);
  background: transparent;
}

.shop-card--compact {
  align-items: flex-start;
  padding: 28rpx 0;
}

.cover-wrap { width: 112rpx; height: 112rpx; flex: none; }

.cover {
  display: block;
  width: 112rpx !important;
  height: 112rpx !important;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--roamly-primary-pale);
}

.cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--roamly-primary);
}

.content {
  min-width: 0;
  flex: 1;
  padding: 0;
}

.title {
  overflow: hidden;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #555362;
  font-size: 23rpx;
}
.stars { color:var(--roamly-primary); font-size:24rpx; }

.rating text {
  margin-left: 8rpx;
  color: #9b99a6;
}

.rating .stars { margin-left: 0; color: var(--roamly-primary); }

.meta {
  overflow: hidden;
  margin-top: 10rpx;
  color: #797785;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-actions { display:flex; gap:20rpx; flex:none; }
.shop-actions view { display:flex; flex-direction:column; align-items:center; gap:3rpx; color:var(--roamly-text); }
.shop-actions text { font-size:18rpx; }

.shop-card--compact .content { padding-top: 2rpx; }
.shop-card--compact .title { margin-bottom: 14rpx; font-size: 29rpx; }
.shop-card--compact .meta { margin-top: 13rpx; color: var(--roamly-text); font-size: 23rpx; }
.shop-card--compact .rating { font-size: 23rpx; }
.shop-card--compact .shop-actions { padding-top: 2rpx; }

.pressable {
  transition:
    transform 160ms ease,
    opacity 160ms ease;
}

.pressable:active {
  transform: scale(0.98);
  opacity: 0.86;
}
