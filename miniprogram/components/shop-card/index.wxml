<view class="shop-card pressable" bind:tap="onSelect"><app-image custom-class="cover" src="{{cover}}" /><view class="content"><view class="title">{{shop.name}}</view><view class="rating"><t-icon name="star-filled" size="28rpx" color="#ff9a43"/> {{score}} <text>{{shop.comments || 0}} 条评价</text></view><view class="meta">{{shop.area || '城市漫游'}} · 人均 ¥{{shop.avgPrice || '--'}}</view><view class="meta">{{distance}} · 月售 {{shop.sold || 0}}</view></view></view>
