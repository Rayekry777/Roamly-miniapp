.navbar { position: sticky; top: 0; z-index: 20; display: grid; min-height: 88rpx; grid-template-columns: 96rpx 1fr 96rpx; align-items: center; background: rgba(244,245,251,.94); backdrop-filter: blur(24rpx); }
.navbar--transparent { background: transparent; backdrop-filter: none; }
.navbar__side { display: flex; width: 96rpx; align-items: center; justify-content: flex-start; }
.navbar__side--right { justify-content: flex-end; }
.navbar__button { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.92); box-shadow: 0 8rpx 26rpx rgba(45,42,80,.08); }
.navbar--transparent .navbar__button { background: rgba(36,35,49,.34); color: #fff; box-shadow: none; }
.navbar__title { overflow: hidden; font-size: 32rpx; font-weight: 700; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.pressable:active { transform: scale(.96); opacity: .82; }
