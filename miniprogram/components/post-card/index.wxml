<view class="post-card">
  <view class="post-card__header">
    <view
      class="post-card__author pressable"
      catch:tap="onOpenAuthor"
      aria-role="button"
      aria-label="查看{{post.author.nickName || 'Roamly 用户'}}的主页"
    >
      <app-image
        class="post-card__avatar"
        custom-class="post-card__avatar"
        src="{{post.author.icon || ''}}"
        kind="avatar"
      />
      <view class="post-card__identity">
        <view class="post-card__name">{{post.author.nickName || "Roamly 用户"}}</view>
        <view class="post-card__time">{{displayTime}}</view>
      </view>
    </view>
    <view
      wx:if="{{post.author.id != currentUserId}}"
      class="post-card__follow pressable {{post.followingAuthor ? 'post-card__follow--active' : ''}}"
      catch:tap="onFollow"
      aria-role="button"
      aria-disabled="{{following}}"
      aria-label="{{post.followingAuthor ? '取消关注作者' : '关注作者'}}"
    >
      {{following ? "处理中" : post.followingAuthor ? "已关注" : "+ 关注"}}
    </view>
  </view>

  <view class="post-card__content pressable" bind:tap="onOpenPost" aria-role="button" aria-label="查看动态详情">
    <view wx:if="{{post.title}}" class="post-card__title">{{post.title}}</view>
    <view class="post-card__summary">{{post.contentPreview}}</view>
  </view>

  <post-media-grid media="{{post.media}}" />

  <view class="post-card__actions">
    <view
      class="post-card__section pressable"
      catch:tap="onOpenSection"
      aria-role="button"
      aria-label="进入{{post.section.name}}分区"
    >
      # {{post.section.name}}
    </view>
    <view class="post-card__metrics">
      <view
        class="post-card__metric pressable"
        catch:tap="onComment"
        aria-role="button"
        aria-label="查看{{post.commentCount || 0}}条评论"
      >
        <t-icon name="chat" size="32rpx" />
        <text>{{post.commentCount || 0}}</text>
      </view>
      <view
        class="post-card__metric pressable {{post.likedByMe ? 'post-card__metric--liked' : ''}}"
        catch:tap="onLike"
        aria-role="button"
        aria-disabled="{{liking}}"
        aria-label="{{post.likedByMe ? '取消点赞' : '点赞'}}"
      >
        <t-icon name="heart" size="32rpx" />
        <text>{{post.likedCount || 0}}</text>
      </view>
    </view>
  </view>

  <highlight-comment
    wx:if="{{post.highlightComment}}"
    comment="{{post.highlightComment}}"
    bind:open="onOpenHighlight"
    bind:openauthor="onOpenHighlightAuthor"
  />
</view>
