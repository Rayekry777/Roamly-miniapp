.post-card {
  padding: 28rpx 28rpx 26rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(45, 42, 80, 0.07);
}

.post-card__header,
.post-card__author,
.post-card__actions,
.post-card__metrics,
.post-card__metric {
  display: flex;
  align-items: center;
}

.post-card__header,
.post-card__actions {
  justify-content: space-between;
}

.post-card__author {
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.post-card__avatar {
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 50%;
}

.post-card__identity {
  min-width: 0;
}

.post-card__name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-card__time {
  margin-top: 5rpx;
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.post-card__follow {
  min-width: 100rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 95, 87, 0.28);
  border-radius: 999rpx;
  color: var(--roamly-primary);
  font-size: 21rpx;
  text-align: center;
}

.post-card__follow--active {
  border-color: var(--roamly-border);
  color: var(--roamly-muted);
}

.post-card__content {
  padding-top: 22rpx;
}

.post-card__title {
  margin-bottom: 10rpx;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.4;
}

.post-card__summary {
  display: -webkit-box;
  overflow: hidden;
  color: #403e4b;
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.post-card__actions {
  gap: 18rpx;
  margin-top: 22rpx;
}

.post-card__section {
  max-width: 360rpx;
  overflow: hidden;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f0efff;
  color: #6658d9;
  font-size: 21rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-card__metrics {
  flex: none;
  gap: 24rpx;
  color: var(--roamly-muted);
}

.post-card__metric {
  min-width: 62rpx;
  justify-content: center;
  gap: 7rpx;
  padding: 8rpx 0;
  font-size: 21rpx;
}

.post-card__metric--liked {
  color: var(--roamly-primary);
}
