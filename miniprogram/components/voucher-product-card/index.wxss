:host {
  display: block;
}

.product-card {
  display: flex;
  min-height: 226rpx;
  gap: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(31, 31, 38, 0.05);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(31, 31, 38, 0.05);
  box-sizing: border-box;
}

.product-card__cover {
  width: 214rpx !important;
  height: 214rpx !important;
  flex: none;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f0f0f4;
}

.product-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.product-card__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--roamly-text);
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-card__tags {
  display: flex;
  overflow: hidden;
  gap: 8rpx;
  margin-top: 10rpx;
  white-space: nowrap;
}

.product-card__tags text {
  overflow: hidden;
  max-width: 220rpx;
  padding: 4rpx 9rpx;
  border-radius: 7rpx;
  background: rgba(255, 95, 87, 0.09);
  color: #d64d46;
  font-size: 18rpx;
  text-overflow: ellipsis;
}

.product-card__shop,
.product-card__sales {
  display: flex;
  min-width: 0;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 9rpx;
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.product-card__shop-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__sales {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 10rpx;
}

.product-card__price {
  min-width: 0;
  color: var(--roamly-primary);
  white-space: nowrap;
}

.product-card__currency {
  font-size: 20rpx;
  font-weight: 750;
}

.product-card__amount {
  font-size: 36rpx;
  font-weight: 820;
}

.product-card__origin {
  margin-left: 8rpx;
  color: #aaa8b1;
  font-size: 18rpx;
  text-decoration: line-through;
}

.product-card__saving {
  margin-left: 7rpx;
  color: #d64d46;
  font-size: 18rpx;
}

.product-card__cta {
  flex: none;
  padding: 12rpx 23rpx;
  border-radius: 999rpx;
  background: var(--roamly-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}
