:host {
  display: block;
}

.product-card {
  display: flex;
  min-height: 286rpx;
  gap: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  background: #fff;
  box-shadow: var(--roamly-shadow);
  box-sizing: border-box;
}

.product-card__cover {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.product-card__cover-wrap {
  width: 252rpx;
  height: 252rpx;
  flex: none;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f1f1f3;
}

.product-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  text-align: left;
}

.product-card__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--roamly-text);
  font-size: 29rpx;
  font-weight: 760;
  line-height: 40rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-card__tags {
  display: flex;
  min-height: 30rpx;
  overflow: hidden;
  gap: 8rpx;
  margin-top: 10rpx;
  white-space: nowrap;
}

.product-card__tag {
  overflow: hidden;
  max-width: 220rpx;
  padding: 4rpx 9rpx;
  border-radius: 6rpx;
  background: #fff1ed;
  color: var(--roamly-primary);
  font-size: 18rpx;
  text-overflow: ellipsis;
}

.product-card__shop,
.product-card__sales {
  display: flex;
  align-items: center;
  min-height: 28rpx;
  min-width: 0;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 9rpx;
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.product-card__shop-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__shop-label {
  flex: none;
  color: var(--roamly-muted);
}

.product-card__sales {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 10rpx;
}

.product-card__price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  min-width: 0;
  line-height: 1;
  color: var(--roamly-primary);
  white-space: nowrap;
}

.product-card__currency {
  font-size: 20rpx;
  font-weight: 750;
}

.product-card__amount {
  font-size: 39rpx;
  font-weight: 820;
}

.product-card__cta {
  display: flex;
  flex: none;
  min-width: 88rpx;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--roamly-primary);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}
