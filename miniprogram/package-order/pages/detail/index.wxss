.detail-page { min-height: 100vh; box-sizing: border-box; padding: 18rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); background: var(--roamly-bg); }
.order-state { margin-bottom: 16rpx; padding: 26rpx 24rpx; border-radius: 22rpx; background: #fff; }
.order-state__title { display: flex; align-items: center; gap: 10rpx; color: var(--roamly-text); font-size: 34rpx; font-weight: 800; }
.order-state__icon { color: var(--roamly-primary); font-size: 38rpx; font-weight: 800; }
.order-state__sub { margin-top: 8rpx; color: var(--roamly-muted); font-size: 22rpx; line-height: 1.45; }
.usage-limit { margin-bottom: 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff1ed; color: var(--roamly-primary); font-size: 22rpx; }
.usage-shop { margin-bottom: 16rpx; padding: 22rpx 24rpx; border-radius: 22rpx; background: #fff; }
.usage-shop__header { display: flex; align-items: center; justify-content: space-between; color: var(--roamly-text); font-size: 25rpx; font-weight: 750; }
.usage-shop__link { color: var(--roamly-primary); font-size: 21rpx; font-weight: 400; }
.usage-shop__name { margin-top: 14rpx; color: var(--roamly-text); font-size: 29rpx; font-weight: 800; }
.usage-shop__address, .usage-shop__hours { display: flex; align-items: center; gap: 7rpx; margin-top: 10rpx; overflow: hidden; color: var(--roamly-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.usage-shop__hours .open-state { color: var(--roamly-success); }
.refund-progress { margin-bottom: 16rpx; padding: 22rpx 24rpx; border-radius: 22rpx; background: #fff; }
.refund-progress__title { display: flex; align-items: center; gap: 8rpx; color: var(--roamly-warning); font-size: 26rpx; font-weight: 800; }
.refund-progress--success .refund-progress__title { color: var(--roamly-success); }
.refund-progress__link { margin-left: auto; color: var(--roamly-primary); font-size: 21rpx; font-weight: 400; }
.refund-progress__text { margin-top: 8rpx; color: var(--roamly-muted); font-size: 21rpx; line-height: 1.5; }
.voucher-list, .order-product, .shop-summary { border-radius: 22rpx; background: #fff; }
.voucher-list { margin-bottom: 16rpx; padding: 22rpx 24rpx; }
.order-product { display: flex; align-items: center; gap: 16rpx; }
.order-product__image { width: 122rpx !important; height: 104rpx !important; flex: none; overflow: hidden; border-radius: 14rpx; background: #f4f4f5; }
.order-product__copy { min-width: 0; flex: 1; }
.order-product__title { overflow: hidden; color: var(--roamly-text); font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.order-product__meta { margin-top: 7rpx; overflow: hidden; color: var(--roamly-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-product__price { margin-top: 10rpx; color: var(--roamly-primary); font-size: 23rpx; font-weight: 700; }
.voucher-divider { height: 1rpx; margin: 20rpx 0; background: var(--roamly-border); }
.voucher-list__title { display: flex; flex-direction: column; align-items: stretch; gap: 10rpx; min-height: 54rpx; color: var(--roamly-text); font-size: 26rpx; font-weight: 800; }
.voucher-list__heading { display:flex; width:100%; min-width:0; flex:none; align-items:center; gap:7rpx; }
.voucher-list__label { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.voucher-count { color: var(--roamly-primary); }
.voucher-actions { display: flex; width:100%; flex:none; align-items: center; justify-content:flex-end; gap: 10rpx; }
.voucher-actions t-button { flex: none; }
.voucher-line { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0 0; color: var(--roamly-text); font-size: 22rpx; }
.voucher-status { color: var(--roamly-primary); }
.voucher-status--pending { color: var(--roamly-warning); }
.order-meta { margin: 16rpx 4rpx 0; color: var(--roamly-muted); font-size: 20rpx; line-height: 1.9; }
.order-meta text { color: var(--roamly-text); }
.shop-summary { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding: 18rpx 24rpx; color: var(--roamly-text); font-size: 22rpx; }
.shop-summary text:last-child { min-width: 0; overflow: hidden; color: var(--roamly-muted); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.notice { margin: 16rpx 0; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff1ed; color: var(--roamly-primary); font-size: 21rpx; }
.action-row { display: flex; gap: 12rpx; margin: 16rpx 0; }
.action-row t-button { flex: 1; }
.reuse-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--roamly-border); background: rgba(255, 255, 255, .97); box-shadow: 0 -8rpx 28rpx rgba(36, 35, 49, .08); }
.reuse-action { display: flex; min-height: 76rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--roamly-primary); color: #fff; font-size: 27rpx; font-weight: 750; }
.module-state { display: flex; min-height: 240rpx; align-items: center; justify-content: center; gap: 14rpx; color: var(--roamly-muted); }
.sr-only { position: absolute; width: 1rpx; height: 1rpx; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
