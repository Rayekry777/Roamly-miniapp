<app-navbar title="订单详情" back />
<view class="page page-enter">
  <view wx:if="{{loading}}" class="module-state"><t-loading size="42rpx" /> 正在加载订单</view>
  <app-empty wx:elif="{{error || !order}}" description="{{error || '订单不存在'}}" action-text="重新加载" bind:action="retry" />
  <block wx:else>
    <view class="order-card roamly-panel"><view class="order-status">{{order.statusText}}</view><view class="title">{{product.title || order.productTitle}}</view><view wx:if="{{product.productTypeLabel}}" class="product-type">{{product.productTypeLabel}} · {{product.saleStatusLabel}}</view><view wx:if="{{product.subtitle}}" class="product-summary">{{product.subtitle}}</view><view class="line">订单号 <text>{{order.orderNo}}</text></view><view class="line">数量 <text>{{order.quantity}}</text></view><view class="line">创建时间 <text>{{order.createdTime}}</text></view><view class="line total">实付 <text>¥{{order.payAmountText}}</text></view></view>
    <view wx:if="{{shop}}" class="shop-row roamly-panel" bind:tap="openShop"><view><view class="shop-name">{{shop.name}}</view><view class="shop-address">{{shop.address || '查看商户详情'}}</view></view><t-icon name="chevron-right" size="36rpx" /></view>
    <view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="notice">暂未接入微信支付，请勿将此订单视为已支付。</view>
    <t-button wx:if="{{order.status === 'PENDING_PAYMENT'}}" block theme="danger" variant="outline" loading="{{cancelling}}" bind:tap="cancel">取消订单</t-button>
  </block>
</view>
