.refund-page { padding-top: 26rpx; padding-bottom:calc(170rpx + env(safe-area-inset-bottom)); }
.refund-product-card { display:flex; align-items:center; gap:22rpx; margin-bottom:20rpx; padding:26rpx 30rpx; border-radius:24rpx; background:#fff; }.refund-product__image { width:140rpx !important; height:120rpx !important; border-radius:14rpx; }.refund-product__title { font-size:30rpx; font-weight:800; }
.refund-card { padding: 30rpx; }
.refund-title { font-size: 31rpx; font-weight: 760; }
.refund-title text { color: var(--roamly-primary); }
.reason-select { display:flex; justify-content:space-between; margin-top:22rpx; padding:24rpx 0; border-bottom:1rpx solid var(--roamly-border); color:var(--roamly-muted); font-size:26rpx; }
.reason-select text { color:var(--roamly-text); font-size:38rpx; }
.note-title { margin-top:28rpx; }
textarea { width:100%; min-height:260rpx; margin-top:18rpx; padding:22rpx; box-sizing:border-box; border-radius:20rpx; background:#f8f8fb; color:var(--roamly-text); }
.count { color:var(--roamly-muted); text-align:right; font-size:20rpx; }
.amount { display:block; margin-top:8rpx; color:var(--roamly-primary); font-size:30rpx; font-weight:760; }
.submit-refund { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:space-between; padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background:#fff; box-shadow:0 -8rpx 28rpx rgba(36,35,49,.08); }.submit-refund > view { color:var(--roamly-muted); font-size:22rpx; }.submit-refund .amount { font-size:36rpx; }
.refund-amount-card { position:relative; }.refund-amount-card > .amount { position:absolute; top:22rpx; right:30rpx; }.amount-note { margin-top:24rpx; color:var(--roamly-muted); font-size:23rpx; }
.reason-mask { position:fixed; z-index:30; inset:0; display:flex; align-items:flex-end; background:rgba(36,35,49,.45); }
.reason-sheet { width:100%; max-height:82vh; overflow:auto; padding:30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:36rpx 36rpx 0 0; background:#fff; }
.sheet-head { position:relative; }.sheet-title { margin-bottom:12rpx; text-align:center; font-size:32rpx; font-weight:780; }.sheet-close { position:absolute; top:-6rpx; right:0; color:var(--roamly-muted); font-size:48rpx; font-weight:300; line-height:1; }
.reason-row { display:flex; justify-content:space-between; padding:24rpx 0; border-bottom:1rpx solid var(--roamly-border); font-size:26rpx; }.reason-check { display:flex; width:40rpx; height:40rpx; align-items:center; justify-content:center; border:2rpx solid #d4d3da; border-radius:50%; color:transparent; font-size:25rpx; }.reason-check--active { border-color:var(--roamly-primary); background:var(--roamly-primary); color:#fff; }.reason-footer { display:flex; gap:16rpx; margin-top:24rpx; }.reason-footer t-button { flex:1; }
.quantity-row { display:flex; align-items:center; justify-content:space-between; padding:22rpx 0 28rpx; color:var(--roamly-muted); font-size:26rpx; }
.quantity-stepper { display:flex; align-items:center; gap:20rpx; color:var(--roamly-text); font-size:32rpx; font-weight:760; }
.quantity-stepper text { display:flex; width:48rpx; height:48rpx; align-items:center; justify-content:center; border:2rpx solid var(--roamly-border); border-radius:50%; }
.quantity-stepper .quantity-stepper__disabled { color:#c7c6ce; }
