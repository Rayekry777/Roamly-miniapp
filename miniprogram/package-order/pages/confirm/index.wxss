.confirm-page { padding: 24rpx 24rpx calc(174rpx + env(safe-area-inset-bottom)); }
.order-card, .amount-card, .error-card { margin-bottom: 20rpx; padding: 28rpx; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(45, 42, 80, .06); }
.shop-name { margin-bottom: 22rpx; font-size: 27rpx; font-weight: 760; }
.product-row { display: flex; gap: 20rpx; }
.product-image { width: 190rpx !important; height: 158rpx !important; flex: none; overflow: hidden; border-radius: 18rpx; }
.product-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.product-title { display: -webkit-box; overflow: hidden; font-size: 27rpx; font-weight: 730; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-validity { overflow: hidden; margin-top: 8rpx; color: var(--roamly-muted); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.unit-price { margin-top: auto; color: var(--roamly-text); font-size: 25rpx; font-weight: 700; text-align: right; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid var(--roamly-border); font-size: 25rpx; }
.quantity-copy { min-width: 0; flex: 1; }
.quantity-label { display: block; white-space: nowrap; }
.limit { display: block; margin-top: 7rpx; color: var(--roamly-muted); font-size: 19rpx; }
.stepper { display: flex; align-items: center; border-radius: 10rpx; background: #f4f4f7; }
.stepper-button { display: flex; width: 58rpx; height: 54rpx; align-items: center; justify-content: center; padding: 0; border-radius: 0; background: transparent; color: var(--roamly-text); font-size: 31rpx; line-height: 1; }
.stepper-button::after { border: 0; }
.stepper-button[disabled] { opacity: .35; }
.stepper-value { width: 54rpx; font-size: 24rpx; font-weight: 700; text-align: center; }
.stock-hint { margin-top: 14rpx; color: var(--roamly-muted); font-size: 19rpx; text-align: right; }
.section-title { margin-bottom: 12rpx; font-size: 29rpx; font-weight: 760; }
.amount-row { display: flex; justify-content: space-between; padding: 15rpx 0; color: #666472; font-size: 24rpx; }
.discount text:last-child { color: var(--roamly-primary); }
.amount-row.pay { margin-top: 8rpx; padding-top: 22rpx; border-top: 1rpx solid var(--roamly-border); color: var(--roamly-text); font-weight: 700; }
.amount-row.pay text:last-child { color: var(--roamly-primary); font-size: 31rpx; }
.server-note { margin-top: 10rpx; color: var(--roamly-muted); font-size: 19rpx; line-height: 1.5; }
.error-card { color: #ba4540; font-size: 22rpx; line-height: 1.55; }
.retry-link { margin-top: 13rpx; color: var(--roamly-primary); font-weight: 700; }
.submit-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 24rpx; padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--roamly-border); background: rgba(255, 255, 255, .97); box-shadow: 0 -8rpx 28rpx rgba(36, 35, 49, .08); }
.submit-total { min-width: 190rpx; color: #65636e; font-size: 20rpx; }
.submit-total view { margin-top: 3rpx; color: var(--roamly-primary); font-size: 39rpx; font-weight: 820; }
.submit-currency { font-size: 21rpx; }
.submit-action { display: flex; min-height: 80rpx; flex: 1; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--roamly-primary); color: #fff; font-size: 28rpx; font-weight: 760; }
.submit-action--disabled { opacity: .46; }
.module-state { display: flex; min-height: 220rpx; align-items: center; justify-content: center; gap: 14rpx; color: var(--roamly-muted); }
