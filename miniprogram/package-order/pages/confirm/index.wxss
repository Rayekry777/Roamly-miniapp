.confirm-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx calc(188rpx + env(safe-area-inset-bottom)); background: var(--roamly-bg); }
.order-card, .amount-card, .payment-card, .error-card { margin-bottom: 20rpx; padding: 26rpx 28rpx; border: 1rpx solid rgba(230, 230, 234, .82); border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(45, 42, 80, .045); }
.order-card__shop { display:flex; align-items:center; justify-content:space-between; min-height: 46rpx; }
.shop-name { overflow: hidden; max-width: 68%; color: var(--roamly-text); font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.shop-link { display: flex; align-items: center; gap: 4rpx; color: var(--roamly-muted); font-size: 22rpx; }
.product-row { display: flex; gap: 20rpx; margin-top: 22rpx; }
.product-image { width: 188rpx !important; height: 156rpx !important; flex: none; overflow: hidden; border-radius: 16rpx; background: #f4f4f5; }
.product-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.product-title { display: -webkit-box; overflow: hidden; color: var(--roamly-text); font-size: 28rpx; font-weight: 760; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-validity { overflow: hidden; margin-top: 8rpx; color: var(--roamly-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-price { margin-top: auto; color: var(--roamly-text); font-size: 30rpx; font-weight: 800; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--roamly-border); font-size: 25rpx; }
.quantity-copy { min-width: 0; flex: 1; }
.quantity-label { display: block; white-space: nowrap; }
.limit { display: block; margin-top: 7rpx; color: var(--roamly-muted); font-size: 19rpx; }
.stepper { display: flex; align-items: center; border: 1rpx solid #e2e2e5; border-radius: 12rpx; background: #fff; }
.stepper-button { display: flex; width: 58rpx; height: 54rpx; align-items: center; justify-content: center; padding: 0; border-radius: 0; background: transparent; color: var(--roamly-text); font-size: 31rpx; line-height: 1; }
.stepper-button::after { border: 0; }
.stepper-button[disabled] { opacity: .35; }
.stepper-value { width: 54rpx; font-size: 24rpx; font-weight: 700; text-align: center; }
.stock-hint { margin-top: 14rpx; color: var(--roamly-muted); font-size: 19rpx; text-align: right; }
.purchase-limit { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #fff1ed; color: var(--roamly-primary); font-size: 23rpx; }
.amount-card { padding-top: 26rpx; padding-bottom: 20rpx; }
.amount-row { display: flex; justify-content: space-between; align-items: center; padding: 0; color: var(--roamly-text); font-size: 27rpx; }
.amount-row--total { font-size: 30rpx; font-weight: 700; }
.subtle { color: #99999f; font-size: 25rpx; font-weight: 400; }
.amount-divider { height: 1rpx; margin: 26rpx 0 0; background: var(--roamly-border); }
.accordion-row { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; border-bottom: 1rpx solid var(--roamly-border); color: var(--roamly-text); font-size: 27rpx; }
.accordion-value { display: flex; align-items: center; gap: 5rpx; color: #9a9a9f; }
.muted-value { color: #9a9a9f; font-size: 25rpx; }
.accordion-detail { padding: 0 4rpx 18rpx; border-bottom: 1rpx solid var(--roamly-border); color: var(--roamly-muted); font-size: 22rpx; line-height: 1.5; }
.subtotal-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; color: var(--roamly-text); font-size: 30rpx; font-weight: 760; }
.sr-only { position: absolute; width: 1rpx; height: 1rpx; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.pay-amount { color: var(--roamly-primary); font-size: 37rpx; font-weight: 820; }
.payment-card { padding-top: 20rpx; padding-bottom: 20rpx; }
.payment-card__row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; font-size: 27rpx; }
.payment-card__label { font-weight: 700; }
.payment-card__value { display: flex; align-items: center; gap: 4rpx; color: #9a9a9f; }
.payment-card__hint { margin-top: 14rpx; color: var(--roamly-muted); font-size: 20rpx; line-height: 1.5; }
.server-note { margin: 2rpx 8rpx 20rpx; color: var(--roamly-muted); font-size: 19rpx; line-height: 1.5; }
.error-card { color: #ba4540; font-size: 22rpx; line-height: 1.55; }
.error-title { color: var(--roamly-primary); font-weight: 700; }
.retry-link { margin-top: 13rpx; color: var(--roamly-primary); font-weight: 700; }
.submit-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 24rpx; padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--roamly-border); background: rgba(255, 255, 255, .97); box-shadow: 0 -8rpx 28rpx rgba(36, 35, 49, .08); }
.submit-total { min-width: 190rpx; color: var(--roamly-primary); font-size: 22rpx; }
.submit-total view { color: var(--roamly-primary); font-size: 45rpx; font-weight: 820; line-height: 1; }
.submit-total > text { display: block; margin-top: 9rpx; color: var(--roamly-primary); font-size: 22rpx; }
.submit-currency { font-size: 21rpx; }
.submit-action { display: flex; min-height: 80rpx; flex: 1; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--roamly-primary); color: #fff; font-size: 28rpx; font-weight: 760; }
.submit-action--disabled { background: #ffb3ae; color: #fff; opacity: 1; }
.module-state { display: flex; min-height: 220rpx; align-items: center; justify-content: center; gap: 14rpx; color: var(--roamly-muted); }
