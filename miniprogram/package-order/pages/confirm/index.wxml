<app-navbar title="" back />

<view class="page confirm-page page-enter">
  <view wx:if="{{loading}}" class="module-state roamly-panel"><t-loading size="42rpx" /> 正在确认价格与库存</view>
  <app-empty wx:elif="{{error && !product}}" description="{{error}}" action-text="重新加载" bind:action="retry" />
  <block wx:else>
    <view class="order-card roamly-panel">
      <view class="order-card__shop pressable" bind:tap="openShop">
        <view class="shop-name">{{shop.name || '适用门店'}}</view>
        <view class="shop-link"><text>门店详情</text><t-icon name="chevron-right" size="30rpx" /></view>
      </view>
      <view class="product-row">
        <app-image src="{{product.cover}}" custom-class="product-image" />
        <view class="product-copy">
          <view class="product-title">{{product.title}}</view>
          <view class="product-validity">{{product.validityText}}</view>
          <view class="product-price">¥{{product.payAmountText}}</view>
        </view>
      </view>
      <view class="quantity-row">
        <view class="quantity-copy"><text class="quantity-label">购买数量</text><text class="limit">每人限购 {{product.perUserLimit || '不限'}} 份</text></view>
        <view class="stepper">
          <button class="stepper-button" disabled="{{!confirmation || quantity <= confirmation.minQuantity || refreshing}}" bind:tap="decrease">−</button>
          <text class="stepper-value">{{quantity}}</text>
          <button class="stepper-button" disabled="{{!confirmation || quantity >= confirmation.maxQuantity || refreshing}}" bind:tap="increase">+</button>
        </view>
      </view>
      <view wx:if="{{confirmation}}" class="stock-hint">当前库存 {{confirmation.availableStock}} 份，最多可购 {{confirmation.maxQuantity}} 份</view>
      <view wx:if="{{product.perUserLimit}}" class="purchase-limit">商品每人限购 {{product.perUserLimit}} 份</view>
    </view>

    <view wx:if="{{product}}" class="amount-card roamly-panel">
      <view class="amount-row amount-row--total"><text>商品总价 <text class="subtle">(共{{confirmation ? confirmation.quantity : quantity}}件)</text></text><text>¥{{confirmation ? confirmation.totalAmountText : fallbackTotalAmountText}}</text></view>
      <view class="amount-divider"></view>
      <view class="accordion-row" bind:tap="toggleSection" data-section="promotion">
        <text>{{promotionLabel}}</text>
        <view class="accordion-value"><text>{{confirmation ? (confirmation.hasPromotion ? '-¥' + confirmation.promotionAmountText : '暂无优惠') : '待确认'}}</text><t-icon name="{{expandedSection === 'promotion' ? 'chevron-up' : 'chevron-down'}}" size="28rpx" /></view>
      </view>
      <view wx:if="{{expandedSection === 'promotion' && confirmation}}" class="accordion-detail">
        <view wx:if="{{confirmation.merchantSubsidyAmount > 0}}" class="amount-row"><text>商家补贴</text><text>-¥{{confirmation.merchantSubsidyAmountText}}</text></view>
        <view wx:if="{{confirmation.platformDiscountAmount > 0}}" class="amount-row"><text>平台补贴</text><text>-¥{{confirmation.platformDiscountAmountText}}</text></view>
        <text wx:if="{{!confirmation.hasPromotion}}">暂无活动优惠</text>
      </view>
      <view class="subtotal-row"><text>小计</text><text class="sr-only">应付金额</text><text class="pay-amount">¥{{confirmation ? confirmation.payAmountText : fallbackPayAmountText}}</text></view>
    </view>

    <view wx:if="{{product}}" class="payment-card roamly-panel">
      <view class="payment-card__row" bind:tap="toggleSection" data-section="payment">
        <view class="payment-card__label">支付方式</view>
        <view class="payment-card__value">Mock 支付 <t-icon name="{{expandedSection === 'payment' ? 'chevron-up' : 'chevron-down'}}" size="28rpx" /></view>
      </view>
      <view wx:if="{{expandedSection === 'payment'}}" class="payment-card__hint">提交后选择模拟支付成功、模拟支付失败或暂不支付</view>
    </view>

    <view wx:if="{{confirmation}}" class="server-note">价格、限购和库存以提交前服务端确认结果为准</view>

    <view wx:if="{{error}}" class="error-card roamly-panel">
      <view class="error-title">{{confirmationErrorTitle || error}}</view>
      <view class="retry-link" bind:tap="retry">重新确认</view>
    </view>
  </block>
</view>

<view wx:if="{{product}}" class="submit-bar">
  <view class="submit-total"><view><text class="submit-currency">¥</text>{{confirmation ? confirmation.payAmountText : (fallbackPayAmountText || '0.00')}}</view><text>{{confirmation ? confirmation.quantity : quantity}}件</text></view>
  <view class="submit-action pressable {{!confirmation || refreshing ? 'submit-action--disabled' : ''}}" bind:tap="submit">{{submitting ? '提交中…' : (createdOrderId ? '查看订单' : '提交订单')}}</view>
</view>
