.order-list-page { min-height:100vh; padding:24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); background:var(--roamly-bg); }
.order-search { display:flex; align-items:center; gap:14rpx; min-height:76rpx; padding:0 24rpx; border-radius:999rpx; background:#fff; color:#b7b6bd; font-size:25rpx; }
.order-search t-search { min-width:0; flex:1; padding:0; }
.order-category { display:flex; flex:none; align-items:center; gap:2rpx; color:var(--roamly-text); font-size:24rpx; }
.filters { display: flex; justify-content:space-between; gap: 28rpx; margin: 30rpx 0 24rpx; overflow-x: auto; white-space: nowrap; }
.filter { position:relative; padding-bottom:14rpx; color: var(--roamly-muted); font-size: 27rpx; }
.filter--active { color: var(--roamly-text); font-weight: 800; }
.filter--active::after { position:absolute; right:12rpx; bottom:0; left:12rpx; height:6rpx; border-radius:6rpx; background:linear-gradient(90deg,var(--roamly-primary),#ff9a73); content:""; }
.order-card { margin-bottom:20rpx; padding:26rpx 24rpx; border-radius:22rpx; background:#fff; box-shadow:0 4rpx 18rpx rgba(36,35,49,.035); }
.order-head { display: flex; align-items:center; justify-content: space-between; gap: 16rpx; }
.order-brand { display:flex; min-width:0; align-items:center; gap:12rpx; }
.brand-icon { display:flex; width:46rpx; height:46rpx; align-items:center; justify-content:center; border-radius:50%; background:var(--roamly-primary); color:#fff; font-size:22rpx; }
.order-title { overflow:hidden; font-size: 28rpx; font-weight: 700; text-overflow:ellipsis; white-space:nowrap; }
.status { color: var(--roamly-primary); font-size: 24rpx; }
.order-body { display:flex; gap:20rpx; margin-top:24rpx; }
.order-thumb { display:flex; width:152rpx; height:152rpx; flex:none; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; overflow:hidden; border-radius:16rpx; background:var(--roamly-primary-soft); color:var(--roamly-primary); font-size:22rpx; font-weight:700; }
.order-thumb__image { width:100% !important; height:100% !important; }
.order-copy { min-width:0; flex:1; }
.order-copy__title { overflow:hidden; font-size:29rpx; font-weight:700; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.order-copy__price { margin-top:24rpx; font-size:26rpx; }
.meta { margin-top:14rpx; color: var(--roamly-muted); font-size: 21rpx; }
.order-actions { display:flex; align-items:center; justify-content:flex-end; gap:16rpx; margin-top:22rpx; padding-top:20rpx; border-top:1rpx solid var(--roamly-border); }
.order-date { margin-right:auto; color:var(--roamly-muted); font-size:20rpx; }
.module-state { display: flex; min-height: 240rpx; align-items: center; justify-content: center; gap: 14rpx; color: var(--roamly-muted); }
