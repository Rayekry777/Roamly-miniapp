<app-navbar title="账单详情" back />
<view class="page refund-detail-page page-enter">
  <view wx:if="{{loading}}" class="module-state"><t-loading size="42rpx" /> 正在加载退款详情</view>
  <app-empty wx:elif="{{error || !refund}}" description="{{error || '退款记录不存在'}}" action-text="重新加载" bind:action="retry" />
  <block wx:else>
    <view class="refund-hero roamly-panel"><view class="refund-status-icon refund-status-icon--{{refund.executionStatus}}">退</view><view class="refund-product">退款-{{refund.productTitle || '团购券'}}</view><view class="refund-amount">{{refund.executionStatus === 'SUCCESS' ? '+' : ''}}¥{{refund.amountText}}</view><view class="refund-status-title">{{refund.statusText}}</view></view>
    <view class="refund-info roamly-panel"><view class="info-row"><text>关联记录</text><text bind:tap="openOrder">查看原订单 ›</text></view><view class="info-row"><text>退款至</text><text>{{refund.paymentChannel || 'Mock 原支付渠道'}}</text></view><view class="info-row"><text>审核结果</text><text>{{refund.decisionText}}</text></view><view class="info-row"><text>执行状态</text><text>{{refund.statusText}}</text></view><view class="timeline"><view wx:for="{{timeline}}" wx:key="key" class="timeline-item timeline-item--active">{{item.title}}<text>{{item.description || item.statusText}} · {{item.timeText}}</text></view></view><view class="info-row"><text>申请金额</text><text>¥{{refund.amountText}}</text></view><view class="info-row"><text>退款单号</text><text>{{refund.refundNo || refund.id}}</text></view><view class="info-row"><text>商家单号</text><text>{{refund.merchantOrderNo || refund.orderId}}</text></view><view wx:if="{{refund.reason || refund.description}}" class="refund-reason"><view class="reason-title">退款原因</view><view>{{refund.reason || '未填写原因'}}</view><view wx:if="{{refund.description}}" class="reason-description">{{refund.description}}</view></view><view wx:if="{{refund.rejectReason || refund.failureMessage}}" class="refund-reason"><view class="reason-title">处理说明</view><view>{{refund.rejectReason || refund.failureMessage}}</view></view></view>
    <view class="original-order roamly-panel" bind:tap="openOrder">订单详情 <text class="original-order__link">查看原订单 ›</text></view>
    <view class="refund-faq roamly-panel" bind:tap="openCustomerService"><view class="faq-title">退款进度需要帮助</view><view class="faq-q">联系平台客服</view><view class="faq-a">工单会自动关联当前退款、订单和团购券。</view></view>
  </block>
</view>
