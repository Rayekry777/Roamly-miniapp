<app-navbar title="账单详情" back />
<view class="page refund-detail-page page-enter">
  <view wx:if="{{loading}}" class="module-state"><t-loading size="42rpx" /> 正在加载退款详情</view>
  <app-empty wx:elif="{{error || !refund}}" description="{{error || '退款记录不存在'}}" action-text="重新加载" bind:action="retry" />
  <block wx:else>
    <view class="refund-hero roamly-panel"><view class="refund-status-icon refund-status-icon--{{refund.status}}">退</view><view class="refund-product">退款-{{refund.productTitle || '团购券'}}</view><view class="refund-amount">{{refund.status === 'SUCCEEDED' ? '+' : ''}}¥{{refund.amountText}}</view><view class="refund-status-title">{{refund.statusText}}</view></view>
    <view class="refund-info roamly-panel"><view class="info-row"><text>关联记录</text><text bind:tap="openOrder">查看原订单 ›</text></view><view class="info-row"><text>退款至</text><text>{{refund.paymentChannel || '原支付渠道'}}</text></view><view class="info-row"><text>退款进度</text><text>{{refund.statusText}}</text></view><view class="timeline"><view class="timeline-item timeline-item--active">退款申请已受理<text>{{refund.requestedTime || ''}}</text></view><view class="timeline-item {{refund.status === 'PROCESSING' || refund.status === 'SUCCEEDED' ? 'timeline-item--active' : ''}}">退款处理中<text>{{refund.status === 'REQUESTED' ? '等待平台处理' : (refund.processedTime || '通常 1-3 个工作日完成')}}</text></view><view wx:if="{{refund.status === 'SUCCEEDED'}}" class="timeline-item timeline-item--active">退款成功<text>{{refund.processedTime || ''}}</text></view><view wx:if="{{refund.status === 'FAILED' || refund.status === 'REJECTED'}}" class="timeline-item timeline-item--active">{{refund.status === 'REJECTED' ? '退款被拒' : '退款失败'}}<text>{{refund.processedTime || '请查看退款说明或联系商户'}}</text></view></view><view class="info-row"><text>申请金额</text><text>¥{{refund.amountText}}</text></view><view class="info-row"><text>退款单号</text><text>{{refund.refundNo || refund.id}}</text></view><view class="info-row"><text>商家单号</text><text>{{refund.merchantOrderNo || refund.orderId}}</text></view><view wx:if="{{refund.reason || refund.description}}" class="refund-reason"><view class="reason-title">退款原因</view><view>{{refund.reason || '未填写原因'}}</view><view wx:if="{{refund.description}}" class="reason-description">{{refund.description}}</view></view></view>
    <view class="original-order roamly-panel" bind:tap="openOrder">订单详情 <text class="original-order__link">查看原订单 ›</text></view>
    <view class="refund-faq roamly-panel"><view class="faq-title">常见问题</view><view class="faq-q">退款受理后资金何时到账？</view><view class="faq-a">退款一般需要 1-3 个工作日，实际到账时间以支付渠道为准。</view></view>
  </block>
</view>
