.refund-detail-page { padding-top: 26rpx; }
.refund-hero, .refund-info, .refund-faq { margin-bottom: 22rpx; padding: 34rpx 30rpx; text-align: center; }
.refund-status-icon { width: 88rpx; height: 88rpx; margin: 0 auto 18rpx; border-radius: 50%; background: var(--roamly-primary); color: #fff; font-size: 48rpx; line-height: 88rpx; }
.refund-status-icon--REQUESTED, .refund-status-icon--PROCESSING { background: var(--roamly-warning); }
.refund-status-icon--SUCCEEDED { background: var(--roamly-success); }
.refund-status-icon--FAILED, .refund-status-icon--REJECTED { background: var(--roamly-primary); }
.refund-status-title { margin-top:12rpx; color:var(--roamly-muted); font-size:30rpx; font-weight:400; }
.refund-amount { margin-top:12rpx; font-size:52rpx; font-weight:820; }
.refund-product { margin-top:8rpx; color:var(--roamly-text); font-size:29rpx; }
.info-row { display:flex; justify-content:space-between; gap:20rpx; padding:20rpx 0; border-bottom:1rpx solid var(--roamly-border); color:var(--roamly-muted); text-align:left; font-size:24rpx; }
.timeline { margin-top:24rpx; padding-left:30rpx; border-left:4rpx solid var(--roamly-border); text-align:left; }
.timeline-item { position:relative; padding:0 0 26rpx 20rpx; color:var(--roamly-muted); font-size:25rpx; }
.timeline-item::before { position:absolute; top:4rpx; left:-40rpx; width:22rpx; height:22rpx; border-radius:50%; background:#d7d6df; content:""; }
.timeline-item--active { color:var(--roamly-text); font-weight:760; }
.timeline-item--active::before { background:var(--roamly-primary); }
.timeline-item > text { display:block; margin-top:8rpx; color:var(--roamly-muted); font-size:21rpx; font-weight:400; }
.info-row text:last-child { color:var(--roamly-text); text-align:right; }
.refund-reason { margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid var(--roamly-border); color:var(--roamly-text); text-align:left; font-size:24rpx; line-height:1.55; }
.reason-title { margin-bottom:8rpx; font-size:27rpx; font-weight:760; }
.reason-description { margin-top:8rpx; color:var(--roamly-muted); }
.faq-title { text-align:left; font-size:30rpx; font-weight:780; }
.faq-q { margin-top:24rpx; text-align:left; font-size:26rpx; }
.faq-a { margin-top:12rpx; color:var(--roamly-muted); text-align:left; font-size:23rpx; line-height:1.6; }
.original-order { display:flex; justify-content:space-between; margin-bottom:22rpx; padding:28rpx 30rpx; font-size:28rpx; font-weight:800; }.original-order__link { color:var(--roamly-text); font-size:24rpx; font-weight:400; }
