:host { --tabbar-color: #92909d; --tabbar-active: #ff5f57; }
.tabbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; display: grid; height: calc(112rpx + env(safe-area-inset-bottom)); box-sizing: border-box; grid-template-columns: repeat(5, 1fr); align-items: start; padding: 12rpx 20rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(41,39,53,.06); background: rgba(255,255,255,.96); box-shadow: 0 -10rpx 34rpx rgba(45,42,80,.08); backdrop-filter: blur(24rpx); }
.tabbar__item { display: flex; min-width: 0; height: 88rpx; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--tabbar-color); font-size: 20rpx; }
.tabbar__item--active { color: var(--tabbar-active); font-weight: 600; }
.tabbar__publish { display: flex; height: 116rpx; flex-direction: column; align-items: center; justify-content: flex-start; gap: 2rpx; transform: translateY(-34rpx); color: var(--roamly-text); font-size: 20rpx; font-weight: 600; }
.tabbar__publish-button { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border: 8rpx solid #fff; border-radius: 50%; background: linear-gradient(145deg,#ff7166,#ff5f57); box-shadow: 0 12rpx 28rpx rgba(255,95,87,.32); }
.tabbar__placeholder { min-width: 0; }
