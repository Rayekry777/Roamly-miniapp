{
  "pages": [
    "pages/home/index",
    "pages/sections/index",
    "pages/nearby/index",
    "pages/me/index"
  ],
  "subpackages": [
    {
      "root": "package-shop",
      "pages": ["pages/list/index", "pages/detail/index", "pages/reviews/index"]
    },
    {
      "root": "package-post",
      "pages": ["pages/detail/index", "pages/publish/index", "pages/mine/index"]
    },
    {
      "root": "package-section",
      "pages": ["pages/detail/index"]
    },
    {
      "root": "package-user",
      "pages": ["pages/login/index", "pages/profile/index"]
    },
    {
      "root": "package-voucher",
      "pages": ["pages/product/index", "pages/wallet/index"]
    },
    {
      "root": "package-order",
      "pages": ["pages/list/index", "pages/detail/index"]
    }
  ],
  "window": {
    "navigationBarTitleText": "Roamly",
    "navigationBarBackgroundColor": "#f4f5fb",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f4f5fb",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#92909d",
    "selectedColor": "#ff5f57",
    "backgroundColor": "#ffffff",
    "list": [
      { "pagePath": "pages/home/index", "text": "首页" },
      { "pagePath": "pages/sections/index", "text": "分区" },
      { "pagePath": "pages/nearby/index", "text": "附近" },
      { "pagePath": "pages/me/index", "text": "我的" }
    ]
  },
  "permission": {
    "scope.userLocation": { "desc": "用于查询您附近的商户并计算距离" }
  },
  "requiredPrivateInfos": ["getLocation"],
  "lazyCodeLoading": "requiredComponents",
  "renderer": "webview",
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
