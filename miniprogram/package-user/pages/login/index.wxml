<view class="login-page"><view class="orb orb--one"/><view class="orb orb--two"/><app-navbar title="" transparent/>
  <view class="login-panel roamly-panel page-enter"><image class="brand-logo" src="/assets/images/roamly-logo.svg" mode="aspectFit"/><view class="fields"><t-input value="{{phone}}" label="+86" type="number" maxlength="11" placeholder="输入手机号" bind:change="onPhone"/><view class="field-line"/><view class="code-row"><t-input class="code-input" value="{{code}}" type="number" maxlength="6" placeholder="验证码" bind:change="onCode"/><t-button class="code-button" style="width: 178rpx; min-width: 178rpx; padding-left: 4rpx; padding-right: 4rpx;" variant="text" size="small" loading="{{codeLoading}}" disabled="{{countdown > 0 || codeLoading}}" bind:tap="getCode">{{countdown ? countdown + 's' : '获取验证码'}}</t-button></view></view><t-button theme="primary" shape="round" block size="large" loading="{{loading}}" bind:tap="submit">开始漫游</t-button></view>
  <view class="login-foot">继续即代表你同意 Roamly 服务条款</view>
</view>
<success-motion id="login-motion" message="登录成功"/>
