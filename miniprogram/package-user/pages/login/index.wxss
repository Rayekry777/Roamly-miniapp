.login-page { position: relative; min-height: 100vh; overflow: hidden; background: linear-gradient(150deg,#f9faff,#e9e9fb); }.login-panel { position: relative; z-index: 2; margin: 80rpx 34rpx 0; padding: 56rpx 42rpx; }.brand-logo { display: block; width: 96rpx; height: 96rpx; margin-bottom: 44rpx; }.fields { overflow: hidden; margin: 0 0 28rpx; padding: 10rpx 18rpx; border-radius: 32rpx; background: rgba(255,255,255,.82); }.field-line { height: 1rpx; background: var(--roamly-border); }.code-row { display: flex; min-width: 0; align-items: center; gap: 8rpx; }.code-input { min-width: 0; flex: 1; width: 0; }.code-button { flex: 0 0 178rpx; min-width: 178rpx; white-space: nowrap; }.login-foot { position: absolute; bottom: 30rpx; width: 100%; color: #aaa8b5; font-size: 20rpx; text-align: center; }.orb { position: absolute; width: 500rpx; height: 500rpx; border-radius: 50%; opacity: .5; }.orb--one { top: -220rpx; right: -160rpx; background: #ffd9d5; }.orb--two { bottom: -260rpx; left: -180rpx; background: #dcd7ff; }
