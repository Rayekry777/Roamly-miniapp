<app-navbar title="用户主页"/>
<view class="page page-enter">
  <view wx:if="{{loading}}" class="center-state"><t-loading size="52rpx" text="加载用户资料"/></view>
  <block wx:elif="{{user}}"><view class="profile roamly-panel"><view class="avatar"><app-image src="{{user.icon}}" kind="avatar"/></view><view class="name">{{user.nickName || 'Roamly 用户'}}</view><view class="gender">{{user.gender === 'MALE' ? '男' : user.gender === 'FEMALE' ? '女' : '保密'}}</view><t-button wx:if="{{user.id !== currentUserId}}" theme="primary" shape="round" variant="{{following ? 'outline' : 'base'}}" loading="{{toggling}}" bind:tap="toggleFollow">{{following ? '已关注' : '关注'}}</t-button><view class="stats"><view><text class="strong">{{user.followee || 0}}</text><text>关注</text></view><view><text class="strong">{{user.fans || 0}}</text><text>粉丝</text></view><view><text class="strong">{{user.postCount || 0}}</text><text>动态</text></view></view></view><view class="section"><view class="section-title">Ta 的动态</view><app-empty wx:if="{{postsError}}" description="{{postsError}}" action-text="重新加载" bind:action="load"/><view wx:else class="stack"><post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:openpost="openPost"/></view><app-empty wx:if="{{!postsError && !posts.length}}" description="还没有发布动态"/></view></block>
  <app-empty wx:else description="用户不存在"/>
</view>
