.profile { padding: 42rpx 34rpx; text-align: center; }.avatar { width: 150rpx; height: 150rpx; overflow: hidden; margin: 0 auto 24rpx; border-radius: 48rpx; }.name { font-size: 40rpx; font-weight: 750; }.bio { margin: 14rpx 0 26rpx; color: var(--roamly-muted); font-size: 23rpx; }.stats { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 30rpx; padding-top: 28rpx; border-top: 1rpx solid var(--roamly-border); }.stats .strong { color: var(--roamly-text); font-size: 30rpx; font-weight: 700; }.stats text { display: block; margin-top: 6rpx; color: var(--roamly-muted); font-size: 21rpx; }
