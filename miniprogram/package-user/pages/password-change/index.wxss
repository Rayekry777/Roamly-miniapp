.security-page { min-height:100vh; padding:28rpx; background:var(--roamly-bg); }.security-card { overflow:hidden; margin-bottom:30rpx; padding:10rpx 20rpx; }.phone-tip { padding:18rpx 0; color:var(--roamly-muted); font-size:23rpx; }.divider { height:1rpx; background:var(--roamly-border); }.code-row { display:flex; align-items:center; gap:8rpx; }.code-input { min-width:0; flex:1; }.code-button { flex:none; width:180rpx; }.tip { margin-top:28rpx; color:var(--roamly-muted); font-size:22rpx; text-align:center; }
