.account-page { min-height:100vh; padding:28rpx 28rpx 80rpx; background:var(--roamly-bg); box-sizing:border-box; }.account-card { overflow:hidden; padding:0 28rpx; }.account-row { display:flex; min-height:104rpx; align-items:center; justify-content:space-between; gap:20rpx; }.label { flex:none; font-size:28rpx; font-weight:650; }.row-value { display:flex; min-width:0; align-items:center; gap:16rpx; color:var(--roamly-muted); font-size:25rpx; }.avatar { width:86rpx; height:86rpx; overflow:hidden; border-radius:50%; }.divider { height:1rpx; background:var(--roamly-border); }.nickname-block { padding-bottom:18rpx; }.nickname-input { width:420rpx; text-align:right; }.nickname-meta { display:flex; justify-content:flex-end; gap:20rpx; color:var(--roamly-muted); font-size:21rpx; }.action,.clear { color:var(--roamly-primary); }.birthday-row { position:relative; }.birthday-picker { width:100%; }.clear { position:absolute; top:38rpx; right:190rpx; font-size:22rpx; }.profile-save-state { margin-top:20rpx; color:var(--roamly-muted); font-size:22rpx; text-align:center; }.logout-button { margin-top:34rpx; }
