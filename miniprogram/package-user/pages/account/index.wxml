<app-navbar title="个人信息"/>
<view class="account-page page-enter">
  <view wx:if="{{loading}}" class="center-state"><t-loading size="52rpx" text="加载个人信息"/></view>
  <block wx:elif="{{profile}}">
    <view class="account-card roamly-panel">
      <view class="account-row pressable" bind:tap="chooseAvatar"><text class="label">头像</text><view class="row-value"><view class="avatar"><app-image src="{{profile.icon}}" kind="avatar"/></view><text>{{savingAvatar ? '保存中' : '更换 ›'}}</text></view></view>
      <view class="divider"/>
      <view class="nickname-block"><view class="account-row"><text class="label">昵称</text><t-input class="nickname-input" value="{{nickname}}" maxlength="16" disabled="{{!profile.nicknameEditable}}" placeholder="2–16个字符" bind:change="onNickname"/></view><view class="nickname-meta"><text>{{profile.nicknameEditable ? '今天还可以修改一次' : '今天已修改，明天可再次修改'}}</text><text wx:if="{{profile.nicknameEditable}}" class="action pressable" bind:tap="saveNickname">{{savingNickname ? '保存中' : '保存昵称'}}</text></view></view>
      <view class="divider"/>
      <view class="account-row pressable" bind:tap="openPhoneChange"><text class="label">手机号</text><text class="row-value">{{profile.phone}} ›</text></view>
      <view class="divider"/>
      <view class="account-row pressable" bind:tap="openPasswordChange"><text class="label">密码</text><text class="row-value">重置密码 ›</text></view>
      <view class="divider"/>
      <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" disabled="{{savingProfile || loggingOut}}" bind:change="onGender"><view class="account-row pressable"><text class="label">性别</text><text class="row-value">{{genderLabel}} ›</text></view></picker>
      <view class="divider"/>
      <view class="birthday-row"><picker class="birthday-picker" mode="date" value="{{birthday || today}}" end="{{today}}" disabled="{{savingProfile || loggingOut}}" bind:change="onBirthday"><view class="account-row pressable"><text class="label">生日</text><text class="row-value">{{birthday || '未设置'}} ›</text></view></picker><text wx:if="{{birthday}}" class="clear pressable" bind:tap="clearBirthday">清除</text></view>
    </view>
    <view wx:if="{{savingProfile}}" class="profile-save-state">正在自动保存…</view>
    <t-button class="logout-button" theme="danger" variant="outline" shape="round" block size="large" loading="{{loggingOut}}" disabled="{{savingProfile}}" bind:tap="logout">退出登录</t-button>
  </block>
</view>
