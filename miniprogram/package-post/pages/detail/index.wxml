<app-navbar title="动态详情" />

<view class="detail-page page-enter">
  <view wx:if="{{loading}}" class="detail-skeleton">
    <t-skeleton theme="avatar" row-col="{{[1, 1, 1, 1]}}" loading />
  </view>

  <app-empty
    wx:elif="{{error || !post}}"
    description="{{error || '动态不存在或已删除'}}"
    action-text="重新加载"
    bind:action="retryPost"
  />

  <block wx:else>
    <view class="post-detail">
      <view class="post-detail__author-row">
        <view
          class="post-detail__author pressable"
          bind:tap="openAuthor"
          aria-role="button"
          aria-label="查看{{post.author.nickName}}的主页"
        >
          <view class="post-detail__avatar">
            <app-image src="{{post.author.icon}}" kind="avatar" />
          </view>
          <view class="post-detail__identity">
            <view class="post-detail__name">{{post.author.nickName || "Roamly 用户"}}</view>
            <view class="post-detail__time">{{displayTime}}</view>
          </view>
        </view>
        <view
          wx:if="{{post.author.id !== currentUserId}}"
          class="post-detail__follow pressable {{post.followingAuthor ? 'post-detail__follow--active' : ''}}"
          bind:tap="toggleAuthorFollow"
          aria-role="button"
          aria-disabled="{{followingAuthor}}"
        >
          {{followingAuthor ? "处理中" : post.followingAuthor ? "已关注" : "+ 关注"}}
        </view>
      </view>

      <view wx:if="{{post.title}}" class="post-detail__title">{{post.title}}</view>
      <view class="post-detail__content">{{post.content}}</view>
      <post-media-grid media="{{post.media}}" />

      <shop-link-card
        wx:if="{{post.shopVisit && post.shop}}"
        shop="{{post.shop}}"
        bind:open="openShop"
      />

      <view class="post-detail__footer">
        <view
          class="post-detail__section pressable"
          bind:tap="openSection"
          aria-role="button"
          aria-label="进入{{post.section.name}}分区"
        >
          # {{post.section.name}}
        </view>
        <view class="post-detail__metrics">
          <view class="post-detail__metric pressable" bind:tap="beginRootComment">
            <t-icon name="chat" size="34rpx" />
            <text>{{post.commentCount || 0}}</text>
          </view>
          <view
            class="post-detail__metric pressable {{post.likedByMe ? 'post-detail__metric--liked' : ''}}"
            bind:tap="togglePostLike"
            aria-disabled="{{likingPost}}"
          >
            <t-icon name="heart" size="34rpx" />
            <text>{{post.likedCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>

    <view id="comments" class="comments">
      <view class="comments__header">
        <view class="comments__tabs" aria-role="tablist">
          <view
            class="comments__tab {{commentSort === 'HOT' ? 'comments__tab--active' : ''}}"
            data-sort="HOT"
            bind:tap="switchCommentSort"
            aria-role="tab"
            aria-selected="{{commentSort === 'HOT'}}"
          >
            热门
          </view>
          <view
            class="comments__tab {{commentSort === 'LATEST' ? 'comments__tab--active' : ''}}"
            data-sort="LATEST"
            bind:tap="switchCommentSort"
            aria-role="tab"
            aria-selected="{{commentSort === 'LATEST'}}"
          >
            最新
          </view>
        </view>
      </view>

      <view wx:if="{{commentsLoading && !commentThreads.length}}" class="comments__skeleton">
        <t-skeleton theme="avatar" row-col="{{[1, 1, 1]}}" loading />
      </view>

      <app-empty
        wx:elif="{{commentsError && !commentThreads.length}}"
        description="{{commentsError}}"
        action-text="重新加载"
        bind:action="retryComments"
      />

      <app-empty
        wx:elif="{{!commentThreads.length}}"
        description="还没有讨论，来写下第一条评论"
        action-text="参与讨论"
        bind:action="beginRootComment"
      />

      <block wx:else>
        <view wx:if="{{commentsError}}" class="inline-error" bind:tap="retryComments">
          {{commentsError}} · 点击重试
        </view>
        <comment-thread
          wx:for="{{commentThreads}}"
          wx:key="id"
          thread="{{item}}"
          liking-ids="{{likingCommentIds}}"
          deleting-ids="{{deletingCommentIds}}"
          highlighted-id="{{highlightedCommentId}}"
          bind:reply="beginReply"
          bind:like="toggleCommentLike"
          bind:delete="deleteOwnComment"
          bind:loadreplies="loadMoreReplies"
          bind:openauthor="openCommentAuthor"
        />
        <view class="list-footer">
          {{commentsLoading ? "正在加载更多" : commentsHasMore ? "继续上滑加载" : "讨论已经到底了"}}
        </view>
      </block>
    </view>
  </block>
</view>

<view wx:if="{{post}}" class="composer-fixed">
  <reply-composer
    target-name="{{replyTarget ? replyTarget.user.nickName : ''}}"
    loading="{{submittingComment}}"
    focus-token="{{composerFocusToken}}"
    reset-token="{{composerResetToken}}"
    draft-text="{{composerDraft}}"
    bind:submit="submitComment"
    bind:cancelreply="cancelReply"
  />
</view>
