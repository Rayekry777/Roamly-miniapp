<app-navbar title="发布探店" emit-back bind:back="leave"><t-button slot="right" theme="primary" variant="text" loading="{{submitting}}" bind:tap="submit">发布</t-button></app-navbar>
<view class="page page-enter"><view class="form roamly-panel"><t-input value="{{title}}" borderless placeholder="给这次漫游起个标题…" maxlength="40" bind:change="onTitle"/><view class="divider"/><t-textarea value="{{content}}" placeholder="分享你的发现、味道和心情…" maxlength="2000" autosize bind:change="onContent"/></view><view class="section"><view class="section-title"><text>添加图片</text><text class="section-link">最多 9 张</text></view><t-upload files="{{files}}" media-type="{{['image']}}" max="9" size-limit="{{10240}}" grid-config="{{ {column: 3, width: 200, height: 200} }}" bind:select-change="onSelect" bind:remove="remove"/><view wx:for="{{images}}" wx:key="localPath"><view wx:if="{{item.status === 'failed'}}" class="upload-error"><text>{{item.error}}</text><t-button size="small" variant="text" data-index="{{index}}" bind:tap="retry">重试</t-button></view></view></view><view class="form roamly-panel optional"><t-input value="{{shopId}}" label="商户 ID" type="number" placeholder="选填，关联一家店" bind:change="onShopId"/></view><view class="hint">图片仅支持 JPEG、PNG、WebP，单张不超过 10MB。</view><t-button theme="primary" shape="round" block size="large" loading="{{submitting}}" bind:tap="submit">发布探店笔记</t-button></view><success-motion id="publish-motion" message="发布成功"/>
