<app-navbar title="笔记详情"/>
<view class="page page-enter"><view wx:if="{{loading}}" class="center-state"><t-loading size="52rpx" text="加载笔记"/></view><view wx:elif="{{blog}}"><view class="author pressable" bind:tap="openAuthor"><view class="author__avatar"><app-image src="{{blog.icon}}" kind="avatar"/></view><view><text class="strong">{{blog.name || 'Roamly 用户'}}</text><text>{{blogDate}}</text></view></view><swiper class="gallery" indicator-dots="{{images.length > 1}}"><swiper-item wx:for="{{images.length ? images : ['']}}" wx:key="*this"><app-image src="{{item}}"/></swiper-item></swiper><view class="blog-title">{{blog.title}}</view><view class="body-copy">{{blog.content}}</view><view class="actions"><view class="action {{blog.isLike ? 'action--liked' : ''}} pressable" bind:tap="toggleLike"><t-icon name="heart{{blog.isLike ? '-filled' : ''}}" size="38rpx"/>{{blog.liked || 0}}</view><view class="action"><t-icon name="chat" size="38rpx"/>{{blog.comments || 0}}</view></view><view class="comment roamly-panel"><t-icon name="chat" size="42rpx"/><view><text class="strong">评论功能暂未开放</text><text>评论数量会保留展示，互动能力将在后续开放。</text></view></view></view><app-empty wx:else description="笔记不存在或已删除"/></view>
