.author { display: flex; align-items: center; gap: 20rpx; margin: 10rpx 0 26rpx; }.author__avatar { width: 82rpx; height: 82rpx; overflow: hidden; border-radius: 50%; }.author .strong { margin-top: 0; color: var(--roamly-text); font-size: 28rpx; font-weight: 700; }.author text { display: block; margin-top: 8rpx; color: var(--roamly-muted); font-size: 21rpx; }.gallery { height: 520rpx; overflow: hidden; border-radius: 44rpx; background: #e9e9f0; }.blog-title { margin: 34rpx 0 20rpx; font-size: 42rpx; font-weight: 750; line-height: 1.35; }.body-copy { color: #555362; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; }.actions { display: flex; gap: 20rpx; margin: 32rpx 0; }.action { display: flex; min-width: 96rpx; align-items: center; justify-content: center; gap: 10rpx; padding: 16rpx 22rpx; border-radius: 28rpx; background: #fff; color: var(--roamly-muted); }.action--liked { color: var(--roamly-primary); }.comment { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }.comment .strong { margin-top: 0; color: var(--roamly-text); font-weight: 700; }.comment text { display: block; margin-top: 8rpx; color: var(--roamly-muted); font-size: 21rpx; }
